@model SigortaDernegi.ViewModels.CorporatePageViewModel

@{
    ViewData["Title"] = Model.Page.MenuTitle;
}

@functions {
    private static string GetActionName(string pageKey) => pageKey switch
    {
        "about" => "Index",
        "bylaws" => "Bylaws",
        "legislation" => "Legislation",
        "board" => "Board",
        "committees" => "Committees",
        _ => "Index"
    };

    private static string GetPositionName(BoardPosition position) => position switch
    {
        BoardPosition.President => "Dernek Başkanı",
        BoardPosition.VicePresident => "Başkan Yardımcısı",
        BoardPosition.Treasurer => "Sayman",
        BoardPosition.GeneralSecretary => "Genel Sekreter",
        _ => "Yönetim Üyesi"
    };
}


<main class="corporate-managed-page">
    <div class="container">
        <div class="row g-4 g-xl-5 align-items-start">
            <aside class="col-12 col-lg-3">
                <nav class="corporate-managed-nav" aria-label="Kurumsal sayfalar">
                    <span class="corporate-managed-nav__title">Kurumsal</span>

                    @foreach (var navigationPage in Model.NavigationPages)
                    {
                        var actionName = GetActionName(navigationPage.PageKey);

                        <a asp-area=""
                           asp-controller="About"
                           asp-action="@actionName"
                           class="@(navigationPage.Id == Model.Page.Id ? "is-active" : null)">
                            <span>@navigationPage.MenuTitle</span>
                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </a>
                    }
                </nav>
            </aside>

            <div class="col-12 col-lg-9">
                <div class="board-section-heading board-section-heading--centered">
                    <h2>Yönetim Kurulumuz</h2>
                </div>

                @{
                    var president = Model.BoardMembers.FirstOrDefault(m => m.Position == BoardPosition.President);
                    var otherMembers = Model.BoardMembers.Where(m => m.Position != BoardPosition.President).ToList();
                }

                @if (president == null && otherMembers.Count == 0)
                {
                    <div class="corporate-managed-empty">
                        <i class="bi bi-people" aria-hidden="true"></i>
                        <p>Yönetim kurulu bilgileri yakında eklenecek.</p>
                    </div>
                }
                else
                {
                    <div class="board-hierarchy-layout">
                        @if (president != null)
                        {
                            <div class="board-president-wrapper">
                                <article class="board-member-card board-member-card--president">
                                    <div class="board-member-card__avatar">
                                        @if (!string.IsNullOrWhiteSpace(president.PhotoUrl))
                                        {
                                            <img src="@Url.Content(president.PhotoUrl)"
                                                 alt="@president.FullName" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-person" aria-hidden="true"></i>
                                        }
                                    </div>

                                    <span class="board-member-card__role">
                                        @GetPositionName(president.Position)
                                    </span>

                                    <h3>@president.FullName</h3>

                                    @if (!string.IsNullOrWhiteSpace(president.ProfessionalTitle))
                                    {
                                        <p class="board-member-card__title">
                                            @president.ProfessionalTitle
                                        </p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(president.Biography))
                                    {
                                        <p class="board-member-card__biography">
                                            @president.Biography
                                        </p>
                                    }
                                </article>
                            </div>
                        }

                        @if (otherMembers.Count > 0)
                        {
                            <div class="board-members-grid">
                                @foreach (var member in otherMembers)
                                {
                                    <article class="board-member-card">
                                        <div class="board-member-card__avatar">
                                            @if (!string.IsNullOrWhiteSpace(member.PhotoUrl))
                                            {
                                                <img src="@Url.Content(member.PhotoUrl)"
                                                     alt="@member.FullName" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-person" aria-hidden="true"></i>
                                            }
                                        </div>

                                        <span class="board-member-card__role">
                                            @GetPositionName(member.Position)
                                        </span>

                                        <h3>@member.FullName</h3>

                                        @if (!string.IsNullOrWhiteSpace(member.ProfessionalTitle))
                                        {
                                            <p class="board-member-card__title">
                                                @member.ProfessionalTitle
                                            </p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(member.Biography))
                                        {
                                            <p class="board-member-card__biography">
                                                @member.Biography
                                            </p>
                                        }
                                    </article>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</main>
