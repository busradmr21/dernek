@model SigortaDernegi.ViewModels.CorporatePageViewModel
@{
    ViewData["Title"] = Model.Page.MenuTitle;

    var introSection = Model.Sections.FirstOrDefault(section => section.SectionKey == "intro");
    var bylawsSection = Model.Sections.FirstOrDefault(section => section.SectionKey == "bylaws-text");
    var ethicsSection = Model.Sections.FirstOrDefault(section => section.SectionKey == "ethics-text");
    var documentSection = Model.Sections.FirstOrDefault(section => section.SectionKey == "document");
    var documentUrl = string.IsNullOrWhiteSpace(documentSection?.ImageUrl)
        ? "/documents/elsader-dernek-tuzugu-ve-etik-ilkeler.pdf"
        : Url.Content(documentSection.ImageUrl);
}

@functions {
    private static string GetActionName(string pageKey) => pageKey switch
    {
        "about" => "Index",
        "bylaws" => "Bylaws",
        "legislation" => "Legislation",
        "board" => "Board",
        "committees" => "Committees",
        _ => "Index"
    };
}

<section class="about-hero corporate-managed-hero about-hero--overview">
    <div class="container">
        <h1>@Model.Page.HeroTitle</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Page.HeroDescription))
        {
            <p>@Model.Page.HeroDescription</p>
        }
    </div>
</section>

<main class="corporate-bylaws-page">
    <div class="container">
        <div class="row g-4 g-xl-5 align-items-start">
            <aside class="col-12 col-lg-3">
                <nav class="corporate-managed-nav" aria-label="Kurumsal sayfalar">
                    <span class="corporate-managed-nav__title">Kurumsal</span>
                    @foreach (var navigationPage in Model.NavigationPages)
                    {
                        var actionName = GetActionName(navigationPage.PageKey);
                        <a asp-area=""
                           asp-controller="About"
                           asp-action="@actionName"
                           class="@(navigationPage.Id == Model.Page.Id ? "is-active" : null)">
                            <span>@navigationPage.MenuTitle</span>
                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </a>
                    }
                </nav>
            </aside>

            <div class="col-12 col-lg-9">
                @if (introSection is not null)
                {
                    <section class="corporate-bylaws-intro">
                        @if (!string.IsNullOrWhiteSpace(introSection.Eyebrow))
                        {
                            <span class="corporate-bylaws-eyebrow">@introSection.Eyebrow</span>
                        }
                        <h2>@introSection.Title</h2>
                        <div class="corporate-bylaws-richtext">@Html.Raw(introSection.ContentHtml)</div>
                    </section>
                }

                @if (bylawsSection is not null)
                {
                    <section class="corporate-bylaws-document">
                        @if (!string.IsNullOrWhiteSpace(bylawsSection.Eyebrow))
                        {
                            <span class="corporate-bylaws-eyebrow">@bylawsSection.Eyebrow</span>
                        }
                        <h2>@bylawsSection.Title</h2>
                        <div class="corporate-bylaws-richtext corporate-bylaws-statute-text">
                            @Html.Raw(bylawsSection.ContentHtml)
                        </div>
                    </section>
                }

                @if (ethicsSection is not null)
                {
                    <section class="corporate-bylaws-ethics">
                        @if (!string.IsNullOrWhiteSpace(ethicsSection.Eyebrow))
                        {
                            <span class="corporate-bylaws-eyebrow">@ethicsSection.Eyebrow</span>
                        }
                        <h2>@ethicsSection.Title</h2>
                        <div class="corporate-bylaws-richtext corporate-bylaws-ethics-text">
                            @Html.Raw(ethicsSection.ContentHtml)
                        </div>
                    </section>
                }

                @if (documentSection is not null)
                {
                    <section class="corporate-bylaws-pdf" aria-labelledby="bylaws-document-title">
                        <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                        <div class="corporate-bylaws-pdf__content">
                            <h2 id="bylaws-document-title">@documentSection.Title</h2>
                            @if (!string.IsNullOrWhiteSpace(documentSection.ContentHtml))
                            {
                                <div>@Html.Raw(documentSection.ContentHtml)</div>
                            }
                        </div>
                        <div class="corporate-bylaws-pdf__actions">
                            <a class="btn btn-primary" href="@documentUrl" target="_blank" rel="noopener">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                                Görüntüle
                            </a>
                            <a class="btn btn-outline-primary" href="@documentUrl" download>
                                <i class="bi bi-download" aria-hidden="true"></i>
                                İndir
                            </a>
                            <a class="btn btn-outline-secondary" href="@documentUrl#print" target="_blank" rel="noopener">
                                <i class="bi bi-printer" aria-hidden="true"></i>
                                Yazdır
                            </a>
                        </div>
                    </section>
                    <p class="corporate-bylaws-note">Tüzük metni, genel kurul kararları ve yürürlükteki mevzuat doğrultusunda güncellenir.</p>
                }
            </div>
        </div>
    </div>
</main>
