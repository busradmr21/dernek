@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="container py-3">
    <!-- Sayfa Başlığı -->
    <div class="text-center mb-5">
        <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill mb-2">Vizyon & Misyon</span>
        <h1 class="fw-bold text-dark display-6">Hi Sigorta Hakkında</h1>
        <p class="text-muted col-md-8 mx-auto lead fs-6">
            Sigorta Araştırmacıları ve Uzmanları Derneği (Hi Sigorta), sigorta sektöründe şeffaflık, güven ve etik standartları yükseltmek amacıyla kurulmuştur.
        </p>
    </div>

    <!-- Vizyon ve Misyon Kartları -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-light">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary text-white rounded-circle p-3 me-3">
                        <i class="bi bi-eye fs-3"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-0">Vizyonumuz</h4>
                </div>
                <p class="text-muted lh-lg mb-0">
                    Sigorta araştırmacılığı ve suistimal tespiti alanında ulusal düzeyde standartları belirleyen, teknolojik gelişmelere öncülük eden ve sektördeki tüm paydaşlar için en güvenilir bilgi ve uzmanlık referansı olan lider dernek olmak.
                </p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-light">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-warning text-dark rounded-circle p-3 me-3">
                        <i class="bi bi-bullseye fs-3"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-0">Misyonumuz</h4>
                </div>
                <p class="text-muted lh-lg mb-0">
                    Sigorta suistimalleriyle etkin mücadele etmek, saha ve hasar inceleme uzmanlarının mesleki gelişimlerini desteklemek, etik ilkeleri yaygınlaştırmak ve sektör içi iş birliğini güçlendirerek kamu yararına katkı sağlamak.
                </p>
            </div>
        </div>
    </div>

    <!-- Temel Değerler -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <h3 class="fw-bold text-dark mb-4 text-center">Temel Değerlerimiz</h3>
        <div class="row g-4 text-center">
            <div class="col-md-3">
                <i class="bi bi-shield-check text-warning fs-1 mb-2 d-block"></i>
                <h6 class="fw-bold text-dark">Dürüstlük & Tarafsızlık</h6>
                <small class="text-muted">Tüm inceleme ve araştırmalarda nesnel verilere bağlı kalırız.</small>
            </div>
            <div class="col-md-3">
                <i class="bi bi-lock text-primary fs-1 mb-2 d-block"></i>
                <h6 class="fw-bold text-dark">Gizlilik & Güvenlik</h6>
                <small class="text-muted">Sektörel ve kişisel verilerin korunmasını hassasiyetle sağlarız.</small>
            </div>
            <div class="col-md-3">
                <i class="bi bi-award text-success fs-1 mb-2 d-block"></i>
                <h6 class="fw-bold text-dark">Mesleki Mükemmellik</h6>
                <small class="text-muted">Saha uzmanlarının yetkinliklerini sürekli eğitimlerle destekleriz.</small>
            </div>
            <div class="col-md-3">
                <i class="bi bi-people text-info fs-1 mb-2 d-block"></i>
                <h6 class="fw-bold text-dark">Sektörel Dayanışma</h6>
                <small class="text-muted">Sigorta şirketleri, eksperler ve kamu mercileriyle iş birliği yürütürüz.</small>
            </div>
        </div>
    </div>
</div>