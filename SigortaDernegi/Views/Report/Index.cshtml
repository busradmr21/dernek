@{
    ViewData["Title"] = "Suistimal & Şüpheli Hasar İhbarı";
}

<div class="container py-3">
    <!-- Sayfa Başlığı -->
    <div class="text-center mb-5">
        <span class="badge bg-danger text-white fw-bold px-3 py-2 rounded-pill mb-2">
            <i class="bi bi-shield-lock-fill me-1"></i> Gizli & Anonim İhbar
        </span>
        <h1 class="fw-bold text-dark display-6">Şüpheli Hasar ve Suistimal Bildirimi</h1>
        <p class="text-muted col-md-8 mx-auto">
            Sigorta sektöründe haksız kazanç ve organize suistimallerle mücadele amacıyla tasarlanmış bildirim alanıdır. Kimlik bilgileriniz KVKK uyarınca tamamen koruma altındadır.
        </p>
    </div>

    @if (ViewBag.SuccessMessage != null)
    {
            <div class="alert alert-success border-0 shadow-sm rounded-4 p-4 text-center mb-4">
                <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-2"></i>
                <h5 class="fw-bold">Bildiriminiz Alındı!</h5>
                <p class="mb-0">@ViewBag.SuccessMessage</p>
            </div>
    }

    <div class="row g-4">
        <!-- Bilgilendirme ve Güvenlik Kartı -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-dark text-white mb-4">
                <h5 class="fw-bold text-warning mb-3">
                    <i class="bi bi-incognito me-2"></i>Gizlilik Garantisi
                </h5>
                <p class="small text-light lh-lg mb-3">
                    Aşağıdaki formu doldururken dilerseniz kimlik ve iletişim bilgilerinizi paylaşmadan <strong>tamamen anonim</strong> bildirimde bulunabilirsiniz.
                </p>
                <hr class="border-secondary">
                <ul class="list-unstyled small text-light lh-lg mb-0">
                    <li class="mb-2"><i class="bi bi-check2-circle text-warning me-2"></i>IP adresiniz sistem tarafından kaydedilmez.</li>
                    <li class="mb-2"><i class="bi bi-check2-circle text-warning me-2"></i>Tüm veriler 256-bit SSL şifreleme ile iletilir.</li>
                    <li class="mb-2"><i class="bi bi-check2-circle text-warning me-2"></i>Bildirimler doğrudan İhbar Değerlendirme Komisyonu'na düşer.</li>
                </ul>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-telephone-outbound text-danger me-2"></i>Doğrudan İrtibat Hattı</h6>
                <p class="small text-muted mb-3">Acil ve organize vakalar için dernek hasar denetim masası ile iletişime geçebilirsiniz.</p>
                <div class="fw-bold text-dark fs-5"><i class="bi bi-headset me-2 text-primary"></i>0850 300 00 00</div>
            </div>
        </div>

        <!-- İhbar Formu -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <h4 class="fw-bold text-dark mb-4 border-bottom pb-3">İhbar ve Bildirim Formu</h4>

                <form asp-controller="Report" asp-action="Submit" method="post">
                    <!-- Suistimal Türü & Branş -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">Sigorta Branşı</label>
                            <select class="form-select" required>
                                <option value="">Seçiniz...</option>
                                <option value="1">Kara Araçları (Kasko / Trafik)</option>
                                <option value="2">Yangın ve Sınai Hasarlar</option>
                                <option value="3">Sağlık ve Hayat Sigortaları</option>
                                <option value="4">Nakliyat ve Emtia</option>
                                <option value="5">Sorumluluk ve Diğer</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">İhbar / Suistimal Kategorisi</label>
                            <select class="form-select" required>
                                <option value="">Seçiniz...</option>
                                <option value="1">Kurgusal Kaza / Sahte Tutanak</option>
                                <option value="2">Geçmişe Dönük Poliçe / Hasar Sonrası Sigorta</option>
                                <option value="3">Sahte Medikal / Tıbbi Rapor</option>
                                <option value="4">Kundaklama / Kasıtlı Yangın</option>
                                <option value="5">Organize Şebeke / Mükerrer Hasar</option>
                            </select>
                        </div>
                    </div>

                    <!-- Şüpheli Şahıs / Şirket ve Plaka / Dosya No -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">Şüpheli Şahıs / Şirket / Tamirhane</label>
                            <input type="text" class="form-control" placeholder="Örn: X Otomotiv / Ahmet K.">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">Plaka / Hasar Dosya No (Varsa)</label>
                            <input type="text" class="form-control" placeholder="Örn: 34 ABC 123 veya 2026/98765">
                        </div>
                    </div>

                    <!-- Olay / Suistimal Detayı -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small">Olay Detayları ve Şüphe Nedenleri</label>
                        <textarea class="form-control" rows="5" placeholder="Lütfen olay yerini, tarihini, olaya karışan kişileri ve şüphelerinizi detaylıca açıklayınız..." required></textarea>
                    </div>

                    <!-- Dosya / Kanıt Yükleme -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark small">Fotoğraf / Belge / Kanıt Yükle (İsteğe Bağlı)</label>
                        <input type="file" class="form-control" multiple>
                        <small class="text-muted">PDF, JPG, PNG formatlarında belge veya fotoğraf ekleyebilirsiniz.</small>
                    </div>

                    <!-- Bildirimi Yapan Bilgileri (Opsiyonel) -->
                    <div class="card bg-light border-0 rounded-3 p-3 mb-4">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="anonymousCheck" onchange="toggleReporterInfo(this)">
                            <label class="form-check-label fw-bold text-dark small" for="anonymousCheck">
                                İletişim bilgilerimi vermek istiyorum (Aksi halde bildirim anonim kalır)
                            </label>
                        </div>
                        <div id="reporterInfoFields" class="row g-3 mt-1 d-none">
                            <div class="col-md-6">
                                <input type="text" class="form-control form-control-sm" placeholder="Adınız Soyadınız">
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="form-control form-control-sm" placeholder="Telefon No veya E-posta">
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold rounded-3">
                        <i class="bi bi-shield-exclamation me-2"></i> İhbarı Güvenli Şekilde Gönder
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleReporterInfo(checkbox) {
        var fields = document.getElementById('reporterInfoFields');
        if (checkbox.checked) {
            fields.classList.remove('d-none');
        } else {
            fields.classList.add('d-none');
        }
    }
</script>