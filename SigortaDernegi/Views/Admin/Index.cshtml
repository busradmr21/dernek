@{
    ViewData["Title"] = "Yönetim Paneli";
}

<main class="admin-dashboard">

    <div class="container">

        <div class="admin-dashboard__heading">

            <span>ELSADER Yönetimi</span>

            <h1>Yönetim Paneli</h1>

            <p>
                Site üzerinden gönderilen başvuruları ve kayıtları
                bu bölümden görüntüleyebilirsiniz.
            </p>

        </div>

        <div class="admin-dashboard__grid">

            <!-- Üyelik başvuruları -->
            <a asp-controller="Admin"
               asp-action="MembershipApplications"
               class="admin-dashboard-card">

                <div class="admin-dashboard-card__icon">
                    <i class="bi bi-person-plus"></i>
                </div>

                <h2>Üyelik Başvuruları</h2>

                <p>
                    Online üyelik formundan gönderilen
                    ön başvuruları görüntüleyin.
                </p>

                <span>
                    Başvuruları aç
                    <i class="bi bi-arrow-right"></i>
                </span>

            </a>

            <!-- Gönüllü başvuruları -->
            <a asp-controller="Admin"
               asp-action="Volunteers"
               class="admin-dashboard-card">

                <div class="admin-dashboard-card__icon">
                    <i class="bi bi-people"></i>
                </div>

                <h2>Gönüllü Başvuruları</h2>

                <p>
                    Site üzerinden gönderilen gönüllü
                    başvurularını görüntüleyin.
                </p>

                <span>
                    Başvuruları aç
                    <i class="bi bi-arrow-right"></i>
                </span>

            </a>

            <!-- Bağış kayıtları -->
            <a asp-controller="Admin"
               asp-action="Donations"
               class="admin-dashboard-card">

                <div class="admin-dashboard-card__icon">
                    <i class="bi bi-cash-coin"></i>
                </div>

                <h2>Bağış Kayıtları</h2>

                <p>
                    Sistemde bulunan bağış bildirimlerini
                    ve ödeme kayıtlarını görüntüleyin.
                </p>

                <span>
                    Kayıtları aç
                    <i class="bi bi-arrow-right"></i>
                </span>

            </a>

            <!-- İletişim mesajları -->
            <a asp-controller="Admin"
               asp-action="ContactMessages"
               class="admin-dashboard-card">

                <div class="admin-dashboard-card__icon">
                    <i class="bi bi-envelope-paper"></i>
                </div>

                <h2>İletişim Mesajları</h2>

                <p>
                    İletişim formundan gönderilen soru ve
                    talepleri görüntüleyin.
                </p>

                <span>
                    Mesajları aç
                    <i class="bi bi-arrow-right"></i>
                </span>

            </a>

        </div>

    </div>

</main>
