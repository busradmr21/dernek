@model List<SigortaDernegi.Models.Donation>

@{
    ViewData["Title"] = "Bağış Takibi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-cash-coin text-success me-2"></i>Bağış Kayıtları</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">Panele Dön</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Bağışçı Adı</th>
                        <th>Miktar</th>
                        <th>Ödeme Yöntemi</th>
                        <th>Tarih</th>
                        <th>Açıklama</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Henüz kayıtlı bağış bulunmuyor.</td>
                            </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@item.DonorName</td>
                                        <td class="fw-bold text-success">₺@item.Amount.ToString("N2")</td>
                                        <td><span class="badge bg-secondary">@item.PaymentMethod</span></td>
                                        <td>@item.DonationDate.ToString("dd.MM.yyyy")</td>
                                        <td><small class="text-muted">@item.Description</small></td>
                                    </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>