@model List<SigortaDernegi.Models.Volunteer>

@{
    ViewData["Title"] = "Gönüllü Listesi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-heart-fill text-danger me-2"></i>Gönüllü Başvuruları</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">Panele Dön</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Ad Soyad</th>
                        <th>E-posta / Telefon</th>
                        <th>Uzmanlık Alanı</th>
                        <th>Tarih</th>
                        <th>Notlar</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Henüz gönüllü başvurusu bulunmuyor.</td>
                            </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@item.FullName</td>
                                        <td>
                                            <div>@item.Email</div>
                                            <small class="text-muted">@item.Phone</small>
                                        </td>
                                        <td><span class="badge bg-info text-dark">@item.ExpertiseArea</span></td>
                                        <td>@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                                        <td><small class="text-muted">@item.Notes</small></td>
                                    </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>