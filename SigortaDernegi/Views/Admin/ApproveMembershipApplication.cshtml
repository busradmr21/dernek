@model SigortaDernegi.Areas.Admin.ViewModels.MembershipApplicationApprovalViewModel

@{
    ViewData["Title"] = "Üyelik Başvurusunu Onayla";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="admin-module member-admin-page">
    <div class="admin-module__header">
        <div>
            <span class="admin-module__eyebrow">Üyelik Yönetimi</span>
            <h1>Üyelik Başvurusunu Onayla</h1>
            <p>
                Başvuruyu onayladığınızda üye profili oluşturulur,
                giriş hesabına Member rolü verilir ve kayıt faal duruma gelir.
            </p>
        </div>

        <a asp-action="MembershipApplications"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Başvurulara Dön
        </a>
    </div>

    <div class="admin-form-card mb-4">
        <div class="row g-3">
            <div class="col-md-6">
                <small class="text-muted d-block">Başvuru Sahibi</small>
                <strong>@Model.ApplicantName</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted d-block">Üyelik Türü</small>
                <strong>@Model.MembershipType</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted d-block">Şehir</small>
                <strong>@Model.City</strong>
            </div>
            <div class="col-md-6">
                <small class="text-muted d-block">E-posta</small>
                <a href="mailto:@Model.Email">@Model.Email</a>
            </div>
            <div class="col-md-6">
                <small class="text-muted d-block">Telefon</small>
                <a href="tel:@Model.Phone">@Model.Phone</a>
            </div>
        </div>
    </div>

    <form asp-action="ApproveMembershipApplication"
          method="post"
          class="admin-form-card">
        <input asp-for="ApplicationId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Specialty" class="form-label"></label>
                <input asp-for="Specialty" class="form-control" />
                <span asp-validation-for="Specialty" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="RegistryNumber" class="form-label"></label>
                <input asp-for="RegistryNumber" class="form-control" />
                <span asp-validation-for="RegistryNumber" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Region" class="form-label"></label>
                <input asp-for="Region" class="form-control" />
                <span asp-validation-for="Region" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="ShortDescription" class="form-label"></label>
                <textarea asp-for="ShortDescription"
                          rows="3"
                          class="form-control"></textarea>
                <span asp-validation-for="ShortDescription"
                      class="text-danger"></span>
            </div>
        </div>

        @if (Model.HasExistingAccount)
        {
            <div class="alert alert-info mt-4 mb-0">
                <i class="bi bi-info-circle me-2"></i>
                Bu e-posta adresiyle bir giriş hesabı zaten var. Yeni hesap
                oluşturulmayacak; mevcut hesap üyeye bağlanarak Member rolü verilecek.
            </div>
        }
        else
        {
            <hr class="my-4" />

            <h2 class="h5">Üye giriş hesabı</h2>
            <p class="text-muted">
                Üyenin ilk girişte kullanacağı geçici şifreyi belirleyin ve
                üyeye güvenli bir kanaldan iletin.
            </p>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="TemporaryPassword" class="form-label"></label>
                    <input asp-for="TemporaryPassword" class="form-control" />
                    <span asp-validation-for="TemporaryPassword"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger"></span>
                </div>
            </div>
        }

        <div class="alert alert-warning mt-4">
            <i class="bi bi-eye-slash me-2"></i>
            Onaylanan üye rehberde otomatik yayımlanmaz. Yayın izni ayrıca
            alınmalı ve Üye Yönetimi bölümünden yayımlanmalıdır.
        </div>

        <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
            <a asp-action="MembershipApplications"
               class="btn btn-outline-secondary">
                Vazgeç
            </a>

            <button type="submit"
                    class="btn btn-primary"
                    onclick="return confirm('Bu başvuru onaylanarak kişi faal üye yapılsın mı?');">
                <i class="bi bi-check2-circle"></i>
                Başvuruyu Onayla ve Üyeyi Oluştur
            </button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
