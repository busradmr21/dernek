@model SigortaDernegi.Models.MembershipApplication

@{
    ViewData["Title"] = "Online Üyelik Başvurusu";
}

<!-- Sayfa başlığı -->
<section class="about-hero application-hero corporate-managed-hero about-hero--overview">

    <div class="container">
        <h1>Online Üyelik Başvurusu</h1>

        <p>
            Ön başvuru formunu doldurun; bilgileriniz değerlendirme
            sürecinin başlatılması için güvenli biçimde kaydedilsin.
        </p>

    </div>

</section>

<main class="membership-application-page">

    <div class="container">

        <!-- Başarılı kayıt mesajı -->
        @if (TempData["SuccessMessage"] != null)
        {
                <div class="application-success"
                     role="alert">

                    <i class="bi bi-check-circle-fill"
                       aria-hidden="true"></i>

                    <div>
                        <strong>Başvurunuz alındı</strong>
                        <p>@TempData["SuccessMessage"]</p>
                    </div>

                </div>
        }

        <div class="application-layout">

            <!-- Sol bilgilendirme alanı -->
            <aside class="application-information">

                <span>Başvuru Süreci</span>

                <h2>Başvurunuzu birkaç adımda tamamlayın</h2>

                <p>
                    Başvurunuz kaydedildikten sonra ilgili kurul
                    tarafından değerlendirilir.
                </p>

                <ol>
                    <li>
                        <strong>Bilgilerinizi girin</strong>
                        <small>İletişim ve uzmanlık bilgilerinizi yazın.</small>
                    </li>

                    <li>
                        <strong>Onayları tamamlayın</strong>
                        <small>Tüzük ve bilgilendirme metnini inceleyin.</small>
                    </li>

                    <li>
                        <strong>Başvurunuzu gönderin</strong>
                        <small>Değerlendirme sonucu size bildirilsin.</small>
                    </li>
                </ol>

            </aside>

            <!-- Başvuru formu -->
            <section class="application-form-card">

                <!-- Mobil Sekmeler (Yalnızca mobilde d-lg-none ile görünür, masaüstünde tamamen gizlidir) -->
                <div class="member-portal-mobile-tabs d-lg-none">
                    <a asp-area="Identity" asp-page="/Account/Login" class="member-portal-mobile-tab">
                        <i class="bi bi-lock-fill"></i>
                        <span>Giriş Yap</span>
                    </a>
                    <a asp-area="" asp-controller="Membership" asp-action="Apply" class="member-portal-mobile-tab is-active" aria-current="page">
                        <i class="bi bi-person-plus-fill"></i>
                        <span>Üye Ol</span>
                    </a>
                </div>

                <div class="application-form-card__heading">
                    <span>Üyelik Ön Başvurusu</span>
                    <h2>Başvuru Bilgileri</h2>
                    <p>
                        Yıldızla (*) belirtilen alanların doldurulması
                        zorunludur.
                    </p>
                </div>

                <form asp-controller="Membership"
                      asp-action="Apply"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="application-validation-summary">
                    </div>

                    <!-- Üyelik türü -->
                    <fieldset class="application-fieldset">

                        <legend>Üyelik Türü *</legend>

                        <div class="application-type-options">

                            <label class="application-type-option"
                                   for="typeIndividual">

                                <input asp-for="MembershipType"
                                       id="typeIndividual"
                                       type="radio"
                                       value="Bireysel" />

                                <span>
                                    <i class="bi bi-person-badge"></i>

                                    <strong>Bireysel Üyelik</strong>

                                    <small>
                                        Uzman ve araştırmacılar için
                                    </small>
                                </span>

                            </label>

                            <label class="application-type-option"
                                   for="typeCorporate">

                                <input asp-for="MembershipType"
                                       id="typeCorporate"
                                       type="radio"
                                       value="Kurumsal" />

                                <span>
                                    <i class="bi bi-buildings"></i>

                                    <strong>Kurumsal Üyelik</strong>

                                    <small>
                                        Kurum ve kuruluşlar için
                                    </small>
                                </span>

                            </label>

                        </div>

                        <span asp-validation-for="MembershipType"
                              class="application-field-error">
                        </span>

                    </fieldset>

                    <!-- İletişim bilgileri -->
                    <div class="application-form-grid">

                        <div class="application-form-group application-form-group--full">

                            <label asp-for="ApplicantName" id="applicantNameLabel">
                                @(Model.MembershipType == "Kurumsal" ? "Kurum / Acente Adı *" : "Ad Soyad *")
                            </label>

                            <input asp-for="ApplicantName"
                                   id="applicantNameInput"
                                   placeholder="@(Model.MembershipType == "Kurumsal" ? "Acente veya Kurum Adı" : "Adınız Soyadınız")" />

                            <span asp-validation-for="ApplicantName"
                                  class="application-field-error">
                            </span>

                        </div>

                        <div class="application-form-group">

                            <label asp-for="Email"></label>

                            <input asp-for="Email"
                                   placeholder="ornek@eposta.com" />

                            <span asp-validation-for="Email"
                                  class="application-field-error">
                            </span>

                        </div>

                        <div class="application-form-group">

                            <label asp-for="Phone"></label>

                            <input asp-for="Phone"
                                   placeholder="05XX XXX XX XX" />

                            <span asp-validation-for="Phone"
                                  class="application-field-error">
                            </span>

                        </div>

                        <div class="application-form-group">

                            <label asp-for="Specialty"></label>

                            <select asp-for="Specialty">

                                <option value="">
                                    Seçiniz
                                </option>

                                <option value="Saha Araştırması">
                                    Saha Araştırması
                                </option>

                                <option value="Hasar İnceleme">
                                    Hasar İnceleme
                                </option>

                                <option value="Oto Sigortaları">
                                    Oto Sigortaları
                                </option>

                                <option value="Yangın ve Doğal Afetler">
                                    Yangın ve Doğal Afetler
                                </option>

                                <option value="Sağlık ve Hayat">
                                    Sağlık ve Hayat
                                </option>

                                <option value="Hukuk ve Mevzuat">
                                    Hukuk ve Mevzuat
                                </option>

                                <option value="Kurumsal Temsilci">
                                    Kurumsal Temsilci
                                </option>

                                <option value="Diğer">
                                    Diğer
                                </option>

                            </select>

                            <span asp-validation-for="Specialty"
                                  class="application-field-error">
                            </span>

                        </div>

                        <div class="application-form-group">

                            <label asp-for="City"></label>

                            <input asp-for="City"
                                   placeholder="Örneğin: İstanbul" />

                            <span asp-validation-for="City"
                                  class="application-field-error">
                            </span>

                        </div>

                        <div class="application-form-group application-form-group--full">

                            <label asp-for="Message"></label>

                            <textarea asp-for="Message"
                                      rows="4"
                                      style="resize: none;"
                                      placeholder="Uzmanlığınız veya başvuru nedeniniz hakkında kısa bilgi verebilirsiniz."></textarea>

                            <span asp-validation-for="Message"
                                  class="application-field-error">
                            </span>

                        </div>

                    </div>

                    <!-- Kısa veri bilgilendirmesi -->
                    <div class="application-privacy-note">

                        <i class="bi bi-shield-lock"
                           aria-hidden="true"></i>

                        <p>
                            Formda paylaştığınız bilgiler üyelik
                            başvurusunun değerlendirilmesi ve sizinle
                            iletişim kurulması amacıyla kullanılacaktır.
                        </p>

                    </div>

                    <!-- Onaylar -->
                    <div class="application-check">

                        <input asp-for="HasAcceptedBylaws" />

                        <label asp-for="HasAcceptedBylaws">
                            <a asp-controller="About"
                               asp-action="Bylaws">
                                Dernek Tüzüğü ve Etik İlkeleri
                            </a>
                            okudum ve kabul ediyorum.
                        </label>

                    </div>

                    <span asp-validation-for="HasAcceptedBylaws"
                          class="application-field-error">
                    </span>

                    <div class="application-check">

                        <input asp-for="HasReadKvkkNotice" />

                        <label asp-for="HasReadKvkkNotice">
                            <a asp-controller="Home"
                               asp-action="Privacy"
                               target="_blank"
                               rel="noopener">KVKK Aydınlatma Metni</a>’ni
                            okudum ve üyelik başvurum kapsamında kişisel
                            verilerimin işlenmesi hakkında bilgi edindim.
                        </label>

                    </div>

                    <span asp-validation-for="HasReadKvkkNotice"
                          class="application-field-error">
                    </span>

                    <button type="submit"
                            class="application-submit">

                        <span>Başvuruyu Gönder</span>

                        <i class="bi bi-send-check"
                           aria-hidden="true"></i>

                    </button>

                </form>

            </section>

        </div>

    </div>

</main>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
        <script>
            (function () {
                var typeIndividual = document.getElementById('typeIndividual');
                var typeCorporate = document.getElementById('typeCorporate');
                var label = document.getElementById('applicantNameLabel');
                var input = document.getElementById('applicantNameInput');

                if (!typeIndividual || !typeCorporate || !label || !input) return;

                function updateLabels() {
                    if (typeCorporate.checked) {
                        label.textContent = 'Kurum / Acente Adı *';
                        input.placeholder = 'Acente veya Kurum Adı';
                    } else {
                        label.textContent = 'Ad Soyad *';
                        input.placeholder = 'Adınız Soyadınız';
                    }
                }

                typeIndividual.addEventListener('change', updateLabels);
                typeCorporate.addEventListener('change', updateLabels);

                updateLabels();
            })();
        </script>
}
