@model IReadOnlyList<SigortaDernegi.Models.MemberProfile>

@{
    ViewData["Title"] = "Uzman ve Üye Rehberi";

    var specialties =
        ViewBag.Specialties as IEnumerable<string>
        ?? Enumerable.Empty<string>();

    var cities =
        ViewBag.Cities as IEnumerable<string>
        ?? Enumerable.Empty<string>();

    string? selectedSpecialty = ViewBag.SelectedSpecialty;
    string? selectedCity = ViewBag.SelectedCity;
}

<!-- Sayfa başlığı -->
<section class="about-hero directory-hero corporate-managed-hero about-hero--overview">

    <div class="container">
        <h1>Uzman ve Üye Rehberi</h1>

        <p>
            Yayın izni bulunan faal ELSADER üyelerini uzmanlık
            alanı ve şehre göre inceleyebilirsiniz.
        </p>

    </div>

</section>

<main class="member-directory-page">

    <div class="container">

        <!-- Arama ve filtreleme -->
        <form asp-controller="Membership"
              asp-action="Directory"
              method="get"
              class="directory-filter">

            <div class="directory-filter__group directory-filter__group--search">

                <label for="directorySearch">
                    Üye veya kurum adı
                </label>

                <div class="directory-filter__input">

                    <i class="bi bi-search"
                       aria-hidden="true"></i>

                    <input id="directorySearch"
                           type="search"
                           name="search"
                           value="@ViewBag.Search"
                           placeholder="Üye veya kurum adı" />

                </div>

            </div>

            <div class="directory-filter__group">

                <label for="specialtyFilter">
                    Uzmanlık alanı
                </label>

                <select id="specialtyFilter"
                        name="specialty">

                    <option value="">
                        Tüm uzmanlık alanları
                    </option>

                    @foreach (var specialty in specialties)
                    {
                            <option value="@specialty"
                                    selected="@(selectedSpecialty == specialty)">
                            @specialty
                            </option>
                    }

                </select>

            </div>

            <div class="directory-filter__group">

                <label for="cityFilter">
                    Şehir
                </label>

                <select id="cityFilter"
                        name="city">

                    <option value="">
                        Tüm şehirler
                    </option>

                    @foreach (var city in cities)
                    {
                            <option value="@city"
                                    selected="@(selectedCity == city)">
                            @city
                            </option>
                    }

                </select>

            </div>

            <button type="submit"
                    class="directory-filter__button">

                <i class="bi bi-funnel"
                   aria-hidden="true"></i>

                <span>Filtrele</span>

            </button>

            <a asp-controller="Membership"
               asp-action="Directory"
               class="directory-filter__clear">
                Temizle
            </a>

        </form>

        <!-- Sonuç başlığı -->
        <div class="directory-results-heading">

            <div>
                <span>Rehber Sonuçları</span>
                <h2>ELSADER Üyeleri</h2>
            </div>

            <strong>
                @Model.Count kayıt
            </strong>

        </div>

        @if (Model.Count == 0)
        {
                <!-- Henüz üye yoksa -->
                <div class="directory-empty">

                    <div class="directory-empty__icon"
                         aria-hidden="true">
                        <i class="bi bi-people"></i>
                    </div>

                    <h2>Gösterilecek üye bulunamadı</h2>

                    <p>
                        Arama ölçütlerinize uygun veya yayın izni
                        tamamlanmış bir üye profili henüz bulunmuyor.
                    </p>

                    <a asp-controller="Membership"
                       asp-action="Directory">
                        Filtreleri temizle
                    </a>

                </div>
        }
        else
        {
                <!-- Üye kartları -->
                <div class="member-directory-grid">

                @foreach (var member in Model)
                {
                            <article class="member-directory-card">

                                <div class="member-directory-card__top">

                                    <div class="member-directory-card__avatar"
                                         aria-hidden="true">

                                @if (member.MemberType == "Kurumsal")
                                {
                                                <i class="bi bi-buildings"></i>
                                }
                                else
                                {
                                                <i class="bi bi-person"></i>
                                }

                                    </div>

                                    <div>

                                        <span class="member-directory-card__type">
                                    @member.MemberType Üye
                                        </span>

                                        <h3>@member.DisplayName</h3>

                                    </div>

                                </div>

                                <dl class="member-directory-card__details">

                                    <div>
                                        <dt>Uzmanlık</dt>
                                        <dd>@member.Specialty</dd>
                                    </div>

                                    <div>
                                        <dt>Şehir</dt>
                                        <dd>
                                    @member.City

                                    @if (!string.IsNullOrWhiteSpace(
                                       member.Region))
                                    {
                                                    <span> / @member.Region</span>
                                    }
                                        </dd>
                                    </div>

                                </dl>

                        @if (!string.IsNullOrWhiteSpace(
                           member.ShortDescription))
                        {
                                        <p class="member-directory-card__description">
                                @member.ShortDescription
                                        </p>
                        }

                                <div class="member-directory-card__footer">

                                    <span>
                                        <i class="bi bi-patch-check-fill"
                                           aria-hidden="true"></i>

                                        Faal Üye
                                    </span>

                                    <a asp-controller="Membership"
                                       asp-action="ContactMember"
                                       asp-route-id="@member.Id">
                                        İletişime Geç
                                        <i class="bi bi-envelope"></i>
                                    </a>

                                </div>

                            </article>
                }

                </div>
        }

    </div>

</main>
