@{
    ViewData["Title"] = "Üyelik Koşulları ve Tipleri";
}

<!-- Sayfa başlığı -->
<section class="about-hero membership-hero corporate-managed-hero about-hero--overview">

    <div class="container">
        <h1>Üyelik Koşulları ve Tipleri</h1>

        <p>
            Mesleki bilgi paylaşımını, etik değerleri ve sektörel
            dayanışmayı destekleyen ELSADER üyelik yapısını inceleyin.
        </p>

    </div>

</section>

<!-- Üyelik içeriği -->
<main class="membership-page">

    <div class="container">

        <!-- Bilgilendirme -->
        <div class="membership-notice">

            <i class="bi bi-info-circle"
               aria-hidden="true"></i>

            <div>
                <strong>Ön Bilgilendirme</strong>

                <p>
                    Başvurular dernek tüzüğü ve yetkili kurulun
                    değerlendirmesi doğrultusunda sonuçlandırılır.
                    Kesin belge ve kabul şartları başvuru sahibine
                    ayrıca bildirilir.
                </p>
            </div>

        </div>

        <div class="membership-heading">

            <span>Üyelik Seçenekleri</span>

            <h2>Size uygun üyelik türünü seçin</h2>

            <p>
                Başvuru türünüze göre bilgilerinizi iletebilir ve
                değerlendirme sürecini başlatabilirsiniz.
            </p>

        </div>

        <!-- Üyelik türleri -->
        <div class="membership-types">

            <!-- Bireysel üyelik -->
            <article class="membership-type-card">

                <div class="membership-type-card__icon"
                     aria-hidden="true">
                    <i class="bi bi-person-badge"></i>
                </div>

                <span class="membership-type-card__label">
                    Bireysel
                </span>

                <h3>Uzman ve Araştırmacı Üyeliği</h3>

                <p>
                    Sigorta araştırmaları, saha incelemeleri ve
                    ilgili uzmanlık alanlarında çalışan bireyler için.
                </p>

                <ul>
                    <li>
                        <i class="bi bi-check-circle"></i>
                        Mesleki bilgi paylaşımı
                    </li>

                    <li>
                        <i class="bi bi-check-circle"></i>
                        Eğitim ve etkinliklere katılım
                    </li>

                    <li>
                        <i class="bi bi-check-circle"></i>
                        Komisyon çalışmalarına katkı
                    </li>
                </ul>

                <a asp-controller="Membership"
                   asp-action="Apply"
                   class="membership-type-card__button">

                    <span>Bireysel Başvuru</span>
                    <i class="bi bi-arrow-right"></i>

                </a>

            </article>

            <!-- Kurumsal üyelik -->
            <article class="membership-type-card membership-type-card--featured">

                <div class="membership-type-card__icon"
                     aria-hidden="true">
                    <i class="bi bi-buildings"></i>
                </div>

                <span class="membership-type-card__label">
                    Kurumsal
                </span>

                <h3>Kurumsal Üyelik</h3>

                <p>
                    Sigorta sektöründe faaliyet gösteren ve ELSADER’in
                    amaçlarına katkı sağlamak isteyen kurumlar için.
                </p>

                <ul>
                    <li>
                        <i class="bi bi-check-circle"></i>
                        Kurumsal temsil ve iş birliği
                    </li>

                    <li>
                        <i class="bi bi-check-circle"></i>
                        Sektörel çalışma grupları
                    </li>

                    <li>
                        <i class="bi bi-check-circle"></i>
                        Ortak proje ve etkinlikler
                    </li>
                </ul>

                <a asp-controller="Membership"
                   asp-action="Apply"
                   class="membership-type-card__button">

                    <span>Kurumsal Başvuru</span>
                    <i class="bi bi-arrow-right"></i>

                </a>

            </article>

            <!-- Onursal üyelik -->
            <article class="membership-type-card">

                <div class="membership-type-card__icon"
                     aria-hidden="true">
                    <i class="bi bi-award"></i>
                </div>

                <span class="membership-type-card__label">
                    Onursal
                </span>

                <h3>Onursal Üyelik</h3>

                <p>
                    Mesleğe, sektöre veya derneğin amaçlarına önemli
                    katkı sağlayan kişiler için değerlendirilen üyelik.
                </p>

                <ul>
                    <li>
                        <i class="bi bi-check-circle"></i>
                        Mesleki deneyim paylaşımı
                    </li>

                    <li>
                        <i class="bi bi-check-circle"></i>
                        Akademik ve sektörel katkı
                    </li>

                    <li>
                        <i class="bi bi-check-circle"></i>
                        Yetkili kurul değerlendirmesi
                    </li>
                </ul>

                <div class="membership-type-card__status">
                    Yetkili kurul kararıyla
                </div>

            </article>

        </div>

    </div>

</main>
