@{
    ViewData["Title"] = "İletişim & Konum";
}

<div class="container py-3">
    <!-- Başlık -->
    <div class="text-center mb-5">
        <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill mb-2">Bize Ulaşın</span>
        <h1 class="fw-bold text-dark display-6">İletişim Bilgileri</h1>
        <p class="text-muted col-md-8 mx-auto">
            Dernek faaliyetleri, üyelik süreçleri veya genel sorularınız için bizimle iletişime geçebilirsiniz.
        </p>
    </div>

    @if (ViewBag.SuccessMessage != null)
    {
            <div class="alert alert-success border-0 shadow-sm rounded-4 p-4 text-center mb-4">
                <i class="bi bi-check-circle-fill text-success fs-2 d-block mb-2"></i>
                <h5 class="fw-bold mb-0">@ViewBag.SuccessMessage</h5>
            </div>
    }

    <div class="row g-4 mb-5">
        <!-- İletişim Bilgileri & Kartlar -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
                <div class="d-flex align-items-center">
                    <div class="bg-light p-3 rounded-circle text-primary fs-3 me-3">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Dernek Genel Merkezi</h6>
                        <p class="text-muted small mb-0">Barbaros Bulvarı No: 123 Kat: 4, Beşiktaş / İstanbul</p>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
                <div class="d-flex align-items-center">
                    <div class="bg-light p-3 rounded-circle text-warning fs-3 me-3">
                        <i class="bi bi-telephone-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Telefon & Faks</h6>
                        <p class="text-muted small mb-0">+90 (212) 300 00 00 / +90 (212) 300 00 01</p>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
                <div class="d-flex align-items-center">
                    <div class="bg-light p-3 rounded-circle text-danger fs-3 me-3">
                        <i class="bi bi-envelope-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">E-Posta Adresleri</h6>
                        <p class="text-muted small mb-0">info@hisigorta.org.tr / bilgi@hisigorta.org.tr</p>
                    </div>
                </div>
            </div>

            <!-- Aidat / Banka Hesabı Bilgisi -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-navy text-white" style="background-color: #0d233a;">
                <h6 class="fw-bold text-warning mb-2"><i class="bi bi-bank me-2"></i>Dernek Banka Hesap Bilgileri</h6>
                <small class="text-light d-block mb-1"><strong>Banka:</strong> Türkiye İş Bankası - Beşiktaş Şubesi</small>
                <small class="text-light d-block mb-1"><strong>Alıcı:</strong> Sigorta Araştırmacıları ve Uzmanları Derneği</small>
                <small class="text-light d-block"><strong>IBAN:</strong> TR00 0006 4000 0001 2345 6789 00</small>
            </div>
        </div>

        <!-- İletişim Formu -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <h4 class="fw-bold text-dark mb-4 border-bottom pb-3">Mesaj Gönderin</h4>
                <form asp-controller="Contact" asp-action="Index" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark small">Adınız Soyadınız</label>
                            <input type="text" name="name" class="form-control" placeholder="Örn: Ahmet Yılmaz" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark small">E-Posta Adresiniz</label>
                            <input type="email" name="email" class="form-control" placeholder="ahmet@example.com" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small">Konu</label>
                        <input type="text" name="subject" class="form-control" placeholder="Mesaj konusu" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-dark small">Mesajınız</label>
                        <textarea name="message" class="form-control" rows="5" placeholder="İletmek istediğiniz notu yazınız..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-3">
                        <i class="bi bi-send me-2"></i> Mesajı Gönder
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
