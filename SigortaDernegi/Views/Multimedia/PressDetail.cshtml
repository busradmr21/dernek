@using System.Globalization
@model SigortaDernegi.Models.PressArticle

@{
    ViewData["Title"] = Model.Title;
    var culture = new CultureInfo("tr-TR");

    var startDay = Model.PublishedAt.ToString("dd");
    var startMonth = Model.PublishedAt.ToString("MMMM", culture);
    var startYear = Model.PublishedAt.ToString("yyyy");
    var startDayName = Model.PublishedAt.ToString("dddd", culture);
}

<main class="event-detail-page py-4 py-lg-5">
    <div class="container">

        <!-- Üst Gezinme / Geri Dön -->
        <nav class="event-detail__nav mb-4" aria-label="Gezinme">
            <a asp-controller="Multimedia"
               asp-action="Index"
               asp-fragment="basinda-biz"
               class="event-detail__back-btn">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                <span>Basında Biz Bölümüne Dön</span>
            </a>
            <span class="event-detail__nav-divider">/</span>
            <span class="event-detail__nav-current text-truncate">@Model.Title</span>
        </nav>

        <div class="row g-4 g-xl-5">

            <!-- Sol Kolon: Ana İçerik ve Görsel (col-lg-8) -->
            <div class="col-12 col-lg-8">

                <!-- Başlık ve Rozetler -->
                <header class="event-detail__header mb-4">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="event-badge event-badge--category">
                            <i class="bi bi-journal-text me-1" aria-hidden="true"></i>
                            @Model.Category
                        </span>

                        <span class="event-badge event-badge--upcoming">
                            <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>
                            @Model.PublishedAt.ToString("dd MMMM yyyy", culture)
                        </span>

                        <span class="event-badge event-badge--online">
                            <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>
                            Resmî Basın Bülteni
                        </span>
                    </div>

                    <h1 class="event-detail__title">@Model.Title</h1>

                    @if (!string.IsNullOrWhiteSpace(Model.Summary))
                    {
                        <p class="event-detail__lead">@Model.Summary</p>
                    }
                </header>

                <!-- Basın Görseli (Orantılı, net, sınırlandırılmış) -->
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <div class="event-detail__media-wrapper mb-4">
                        <img src="@Model.ImageUrl"
                             alt="@Model.Title"
                             class="event-detail__media-img" />
                    </div>
                }

                <!-- Metin İçeriği Kartı -->
                <article class="event-detail__content-card p-4 p-md-5 mb-4">
                    <h2 class="event-detail__section-title">
                        <i class="bi bi-newspaper me-2" aria-hidden="true"></i>
                        Haber Metni
                    </h2>

                    <div class="event-detail__richtext">
                        @foreach (var paragraph in Model.Paragraphs)
                        {
                            <p>@paragraph</p>
                        }
                    </div>

                    <!-- Yararlanılan Kaynaklar -->
                    @if (Model.Sources.Count > 0)
                    {
                        <div class="news-source-box mt-4 pt-4 border-top">
                            <h3 class="h6 fw-bold text-dark mb-3">
                                <i class="bi bi-journal-check text-primary me-2" aria-hidden="true"></i>
                                Yararlanılan Resmî Kaynaklar:
                            </h3>
                            <div class="d-flex flex-column gap-2">
                                @foreach (var source in Model.Sources)
                                {
                                    <div class="p-3 rounded-3 border bg-light d-flex align-items-center justify-content-between flex-wrap gap-2">
                                        <span class="small fw-semibold text-secondary">@source.Name</span>
                                        <a href="@source.Url"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                                            <span>Belgeyi İncele</span>
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="event-detail__cta-box mt-4 pt-4 border-top">
                        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-2 text-secondary small">
                                <i class="bi bi-shield-check text-success fs-5"></i>
                                <span>Bu basın dosyası <strong>ELSADER</strong> arşivine aittir.</span>
                            </div>
                            <a asp-controller="Multimedia"
                               asp-action="Index"
                               asp-fragment="basinda-biz"
                               class="event-detail__register-btn">
                                <span>Diğer Basın Haberleri</span>
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </article>

            </div>

            <!-- Sağ Kolon: Yapışkan Bilgi Kartı (col-lg-4) -->
            <div class="col-12 col-lg-4">
                <aside class="event-detail__sidebar">

                    <div class="event-detail__info-card">

                        <!-- Takvim Vurgu Başlığı -->
                        <div class="event-detail__date-hero">
                            <div class="event-detail__date-stamp">
                                <span class="event-detail__date-stamp-day">@startDay</span>
                                <span class="event-detail__date-stamp-month">@startMonth</span>
                            </div>
                            <div class="event-detail__date-hero-text">
                                <span class="event-detail__date-dayname">@startDayName</span>
                                <span class="event-detail__date-full">@Model.PublishedAt.ToString("dd MMMM yyyy", culture)</span>
                            </div>
                        </div>

                        <!-- Bilgi Maddeleri -->
                        <div class="event-detail__info-list">

                            <div class="event-detail__info-item">
                                <div class="event-detail__info-icon">
                                    <i class="bi bi-bookmark-check" aria-hidden="true"></i>
                                </div>
                                <div>
                                    <span class="event-detail__info-label">Kategori</span>
                                    <strong class="event-detail__info-value">@Model.Category</strong>
                                </div>
                            </div>

                            <div class="event-detail__info-item">
                                <div class="event-detail__info-icon">
                                    <i class="bi bi-building-check" aria-hidden="true"></i>
                                </div>
                                <div>
                                    <span class="event-detail__info-label">Yayın Organı / Arşiv</span>
                                    <strong class="event-detail__info-value">ELSADER Basın & Medya</strong>
                                </div>
                            </div>

                            <div class="event-detail__info-item">
                                <div class="event-detail__info-icon">
                                    <i class="bi bi-patch-check" aria-hidden="true"></i>
                                </div>
                                <div>
                                    <span class="event-detail__info-label">Doğruluk Durumu</span>
                                    <strong class="event-detail__info-value">Resmî Açıklama</strong>
                                </div>
                            </div>

                        </div>

                        <!-- Diğer Bölümlere Hızlı Geçiş -->
                        <div class="d-flex flex-column gap-2 mb-3">
                            <a asp-controller="Multimedia"
                               asp-action="Index"
                               asp-fragment="fotograflar"
                               class="event-detail__sidebar-btn">
                                <i class="bi bi-images me-1"></i>
                                <span>Foto Galeriye Git</span>
                            </a>

                            <a asp-controller="Contact"
                               asp-action="Index"
                               class="event-detail__sidebar-outline-btn">
                                <i class="bi bi-envelope me-1"></i>
                                <span>Basın İletişimi</span>
                            </a>
                        </div>

                        <!-- Dernek Destek Notu -->
                        <div class="event-detail__support-note">
                            <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                            <span>Basın bültenleri ve medya röportaj talepleri için dernek sekretaryası ile iletişime geçebilirsiniz.</span>
                        </div>

                    </div>

                </aside>
            </div>

        </div>

    </div>
</main>
