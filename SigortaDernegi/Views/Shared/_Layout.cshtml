<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hi Sigorta | Sigorta Araştırmacıları ve Uzmanları Derneği</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Üst Bilgi Çubuğu (Top Bar) -->
        <div class="bg-dark text-white py-1 px-3 fs-7 border-bottom border-secondary">
            <div class="container d-flex justify-content-between align-items-center small">
                <div>
                    <i class="bi bi-envelope-fill me-1 text-warning"></i> info@hisigorta.org.tr
                </div>
                <div>
                    <a asp-controller="Report" asp-action="Index" class="text-decoration-none d-inline-flex align-items-center">
    <span class="badge bg-warning text-dark me-2">Gizli İhbar Hattı</span>
    <small class="text-white">Sigorta Suistimal Bildirimi İçin İletişime Geçin</small>
</a>
                </div>
            </div>
        </div>

       <!-- Ana Navbar -->
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm" style="background-color: #0d233a;">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="fs-3 me-2 text-warning">Hi Sigorta</span>
                    <span class="fs-6 d-none d-sm-inline-block lh-sm border-start border-secondary ps-2 text-light fw-normal">
                        Sigorta Araştırmacıları ve<br>Uzmanları Derneği
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#hiSigortaNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="hiSigortaNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1 list-unstyled">
                        <!-- Ana Sayfa -->
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Home" asp-action="Donate">
                                <i class="bi bi-cash-coin me-1"></i>Bağış Yap
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Home" asp-action="Volunteer">
                                <i class="bi bi-heart-fill me-1"></i>Gönüllü Ol
                            </a>
                        </li>

                        <!-- Kurumsal -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white fw-semibold" href="#" id="aboutDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Kurumsal
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="aboutDropdown">
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Index">Hakkımızda</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Bylaws">Tüzük & Etik İlkeler</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Board">Yönetim Kurulu</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Committees">Komisyonlar</a></li>
                            </ul>
                        </li>

                        <!-- Üyelik -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white fw-semibold" href="#" id="membershipDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Üyelik
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="membershipDropdown">
                                <li><a class="dropdown-item" asp-controller="Membership" asp-action="Conditions">Üyelik Koşulları & Tipleri</a></li>
                                <li><a class="dropdown-item" asp-controller="Membership" asp-action="Apply">Online Üyelik Başvurusu</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Membership" asp-action="Directory">Uzman & Üye Rehberi</a></li>
                            </ul>
                        </li>

                        <!-- Haberler & Duyurular -->
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="News" asp-action="Index">Haberler & Duyurular</a>
                        </li>

                        <!-- İletişim -->
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Contact" asp-action="Index">İletişim</a>
                        </li>
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3 pt-4">
            @RenderBody()
        </main>
    </div>

    <footer class="text-white pt-4 pb-3 mt-5" style="background-color: #0a192f;">
        <div class="container border-bottom border-secondary pb-3">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <h5 class="text-warning fw-bold">Hi Sigorta</h5>
                    <p class="small text-light">Hi Sigorta Derneği; sigorta suistimalleriyle mücadele etmek, saha inceleme standartlarını yükseltmek ve sektörde etik ilkeleri yaygınlaştırmak amacıyla kurulmuştur.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <h6 class="text-warning">İletişim & Bildirim</h6>
                    <p class="small mb-1">
                        <a asp-controller="Contact" asp-action="Index" class="text-white text-decoration-none">
                            <i class="bi bi-envelope text-warning me-1"></i> Bize Ulaşın / İletişim
                        </a>
                    </p>
                    <p class="small mb-0">
                        <a asp-controller="Report" asp-action="Index" class="text-danger text-decoration-none fw-semibold">
                            <i class="bi bi-shield-exclamation me-1"></i> Gizli İhbar Yap
                        </a>
                    </p>
                </div>
            </div>
        </div>
        <div class="container text-center pt-3 small text-muted">
            &copy; 2026 - Hi Sigorta | Sigorta Araştırmacıları ve Uzmanları Derneği - Tüm Hakları Saklıdır.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
