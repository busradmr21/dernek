@inject SigortaDernegi.Data.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Ana Sayfa";
    var sliders = ViewBag.Sliders as IReadOnlyList<Slider> ?? Array.Empty<Slider>();
    var relatedInstitutions = ViewBag.RelatedInstitutions as IReadOnlyList<RelatedInstitution>
        ?? Array.Empty<RelatedInstitution>();
    var president = ViewBag.President as BoardMember;
    var presidentName = string.IsNullOrWhiteSpace(president?.FullName)
        ? "Yönetim Kurulu Başkanı"
        : president.FullName;
    var presidentMessageTitle = string.IsNullOrWhiteSpace(
        president?.HomepageMessageTitle)
        ? PresidentMessageDefaults.Title
        : president.HomepageMessageTitle;
    var presidentMessageSummary = string.IsNullOrWhiteSpace(
        president?.HomepageMessageSummary)
        ? PresidentMessageDefaults.Summary
        : president.HomepageMessageSummary;
    var presidentPhotoUrl = !string.IsNullOrWhiteSpace(president?.PhotoUrl) && !president.PhotoUrl.Contains("/images/board/")
        ? president.PhotoUrl
        : PresidentMessageDefaults.PhotoUrl;
    var homeMissionSettings = ViewBag.HomeMissionSettings as HomeMissionSettings
        ?? new HomeMissionSettings();
    var contactSettings = ViewBag.ContactSettings as ContactSettings
        ?? new ContactSettings();
    var homeContactSubjects = contactSettings.SubjectOptions
        .Split(
            new[] { '\r', '\n' },
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    var heroSlideCount = sliders.Count + 1;
    var trCulture = new System.Globalization.CultureInfo("tr-TR");

    bool IsSafeSliderLink(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return false;
        }

        if (url.StartsWith("/", StringComparison.Ordinal) &&
            !url.StartsWith("//", StringComparison.Ordinal))
        {
            return true;
        }

        return Uri.TryCreate(url, UriKind.Absolute, out var parsedUrl) &&
               (parsedUrl.Scheme == Uri.UriSchemeHttp ||
                parsedUrl.Scheme == Uri.UriSchemeHttps);
    }
}

@model SigortaDernegi.ViewModels.HomePageViewModel

<!-- Ana sayfa karşılama alanı -->
<div id="homeHeroCarousel"
     class="carousel slide home-slider"
     data-bs-ride="carousel"
     data-bs-interval="3000"
     data-bs-pause="false"
     data-bs-wrap="true"
     aria-label="ELSADER tanıtım ve çalışma alanları">

    @if (heroSlideCount > 1)
    {
        <div class="carousel-indicators">
            @for (var index = 0; index < heroSlideCount; index++)
            {
                <button type="button"
                        data-bs-target="#homeHeroCarousel"
                        data-bs-slide-to="@index"
                        class="@(index == 0 ? "active" : null)"
                        aria-current="@(index == 0 ? "true" : null)"
                        aria-label="@(index + 1). slayt"></button>
            }
        </div>
    }

    <div class="carousel-inner">
        <section class="carousel-item home-hero active"
                 aria-labelledby="homeHeroTitle">
            <div class="container home-hero__grid">
                <div class="home-hero__content">
                    <span class="home-hero__badge">
                        <i class="bi bi-patch-check" aria-hidden="true"></i>
                        Elazığ Sigorta Acentelerinin Ortak Çatısı
                    </span>

                    <h1 id="homeHeroTitle">
                        Uzmanlığı, Etik Değerleri ve
                        <span>Güveni</span>
                        Bir Araya Getiriyoruz
                    </h1>

                    <p>
                        ELSADER; Elazığ sigorta acenteleri arasında
                        bilgi paylaşımını, mesleki dayanışmayı ve etik
                        standartları güçlendiren ortak bir platformdur.
                    </p>
                </div>

                <div class="home-hero__visual">
                    <img src="~/images/hisad-hero.png"
                         alt="ELSADER Elazığ sigorta acenteleri"
                         class="home-hero__image" />
                </div>
            </div>
        </section>

        @foreach (var slider in sliders)
        {
            var titleId = $"homeSliderTitle{slider.Id}";
            var imageUrl = string.IsNullOrWhiteSpace(slider.ImageUrl)
                ? Url.Content("~/images/hisad-hero.png")
                : Url.Content(slider.ImageUrl);

            <section class="carousel-item home-hero"
                     aria-labelledby="@titleId">
                <div class="container home-hero__grid">
                    <div class="home-hero__content">
                        <h1 id="@titleId">@slider.Title</h1>

                        @if (!string.IsNullOrWhiteSpace(slider.Description))
                        {
                            <p>@slider.Description</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(slider.ButtonText) &&
                             IsSafeSliderLink(slider.ButtonUrl))
                        {
                            <a href="@slider.ButtonUrl" class="home-hero__button">
                                <span>@slider.ButtonText</span>
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </a>
                        }
                    </div>

                    <div class="home-hero__visual">
                        <img src="@imageUrl"
                             alt="@slider.Title"
                             class="home-hero__image" />
                    </div>
                </div>
            </section>
        }
    </div>

    @if (heroSlideCount > 1)
    {
        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#homeHeroCarousel"
                data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Önceki</span>
        </button>

        <button class="carousel-control-next"
                type="button"
                data-bs-target="#homeHeroCarousel"
                data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Sonraki</span>
        </button>
    }
</div>

<!-- Yönetim Kurulu Başkanı ve misyon alanı -->
@if (homeMissionSettings.IsActive)
{
    <section class="home-purpose"
             aria-label="Başkan mesajı, misyonumuz ve kuruluş amacımız"
             data-president-message>
        <div class="container">
            <div class="home-purpose__panel">
                <article class="home-purpose__president"
                         aria-labelledby="presidentMessageTitle">
                    <div class="home-purpose__president-body">
                        <img src="@Url.Content(presidentPhotoUrl)"
                             alt="@presidentName"
                             asp-append-version="true" />
                        <span class="home-purpose__photo-overlay" aria-hidden="true"></span>

                        <div class="home-purpose__president-heading president-message__reveal">
                            Yönetim Kurulu Başkanımızdan
                        </div>

                        <div class="home-purpose__president-content">
                            <h2 id="presidentMessageTitle" class="president-message__reveal">
                                @presidentMessageTitle
                            </h2>

                            <p class="home-purpose__president-summary president-message__reveal">
                                @presidentMessageSummary
                            </p>

                            <div class="home-purpose__president-footer president-message__reveal">
                                <div class="home-purpose__identity">
                                    <strong>@presidentName</strong>
                                    <span>Yönetim Kurulu Başkanı</span>
                                </div>

                                <a asp-area=""
                                   asp-controller="About"
                                   asp-action="PresidentMessage"
                                   class="home-purpose__message-button">
                                    <span>Mesajın Tamamını Oku</span>
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </article>

                <article class="home-purpose__mission"
                         aria-labelledby="homeMissionTitle">
                    <span class="home-purpose__mission-eyebrow president-message__reveal">
                        @homeMissionSettings.Eyebrow
                    </span>

                    <h2 id="homeMissionTitle" class="president-message__reveal">
                        @homeMissionSettings.Title
                    </h2>

                    <p class="home-purpose__mission-description president-message__reveal">
                        @homeMissionSettings.Description
                    </p>

                    <div class="home-purpose__principles president-message__reveal">
                        <article class="home-purpose__principle">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <h3>@homeMissionSettings.ResearchTitle</h3>
                            <p>@homeMissionSettings.ResearchDescription</p>
                        </article>

                        <article class="home-purpose__principle">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            <h3>@homeMissionSettings.FraudTitle</h3>
                            <p>@homeMissionSettings.FraudDescription</p>
                        </article>

                        <article class="home-purpose__principle">
                            <i class="bi bi-bank" aria-hidden="true"></i>
                            <h3>@homeMissionSettings.EthicsTitle</h3>
                            <p>@homeMissionSettings.EthicsDescription</p>
                        </article>
                    </div>

                    <div class="home-purpose__legal president-message__reveal">
                        <i class="bi bi-patch-check" aria-hidden="true"></i>
                        <span>@homeMissionSettings.LegalReference</span>
                    </div>
                </article>
            </div>
        </div>
    </section>
}

<!-- Etkinlikler ve güncel haberler -->
<section class="home-updates"
         aria-label="Etkinlikler ve güncel haberler"
         data-home-updates>
    <div class="container">
        <div class="home-updates__layout">
            <section class="home-updates__events home-update-reveal"
                     aria-labelledby="homeEventsTitle">
                <header class="home-updates__header">
                    <h2 id="homeEventsTitle">Etkinlikler</h2>
                    <a id="homeAllEventsLink"
                       asp-controller="Events"
                       asp-action="Index"
                       class="home-updates__all-link">
                        <span>Tüm Etkinlikler</span>
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                </header>

                <nav class="home-event-filters" aria-label="Etkinlik türleri">
                    <button type="button"
                            class="home-event-filter-btn is-active"
                            data-event-filter="all"
                            aria-pressed="true">Tümü</button>
                    <button type="button"
                            class="home-event-filter-btn"
                            data-event-filter="Seminer"
                            aria-pressed="false">Seminerler</button>
                    <button type="button"
                            class="home-event-filter-btn"
                            data-event-filter="Webinar"
                            aria-pressed="false">Webinarlar</button>
                    <button type="button"
                            class="home-event-filter-btn"
                            data-event-filter="Eğitim"
                            aria-pressed="false">Eğitimler</button>
                    <button type="button"
                            class="home-event-filter-btn"
                            data-event-filter="Söyleşi"
                            aria-pressed="false">Söyleşiler</button>
                </nav>

                @{
                    var allEventsList = (Model.UpcomingEvents != null && Model.UpcomingEvents.Count > 3)
                        ? Model.UpcomingEvents
                        : DbContext.AssociationEvents
                            .Where(e => e.IsActive)
                            .OrderByDescending(e => e.IsFeatured)
                            .ThenByDescending(e => e.StartDate)
                            .ToList();
                }

                @if (allEventsList.Count > 0)
                {
                    <div class="home-event-grid" id="homeEventsGrid">
                        @{
                            var eventCardIdx = 0;
                        }
                        @foreach (var eventItem in allEventsList)
                        {
                            var isInitiallyVisible = eventCardIdx < 3;
                            eventCardIdx++;
                            var eventImage = string.IsNullOrWhiteSpace(eventItem.ImageUrl)
                                ? null
                                : Url.Content(eventItem.ImageUrl);
                            var eventLocation = eventItem.IsOnline
                                ? "Çevrim içi"
                                : string.IsNullOrWhiteSpace(eventItem.Location)
                                    ? "Konum yakında açıklanacak"
                                    : eventItem.Location;

                            <article class="home-event-card"
                                     data-event-type="@(eventItem.EventType?.Trim() ?? "")"
                                     style="@(isInitiallyVisible ? "" : "display: none;")">
                                <div class="home-event-card__content">
                                    <span class="home-update-badge">
                                        @(string.IsNullOrWhiteSpace(eventItem.EventType)
                                            ? "Etkinlik"
                                            : eventItem.EventType)
                                    </span>

                                    <time datetime="@eventItem.StartDate.ToString("yyyy-MM-dd")">
                                        @eventItem.StartDate.ToString("dd MMMM yyyy", trCulture)
                                    </time>

                                    <h3>
                                        <a asp-controller="Events"
                                           asp-action="Detail"
                                           asp-route-id="@eventItem.Id">
                                            @eventItem.Title
                                        </a>
                                    </h3>

                                    <p class="home-event-card__location">
                                        <i class="bi @(eventItem.IsOnline ? "bi-camera-video" : "bi-geo-alt")"
                                           aria-hidden="true"></i>
                                        <span>@eventLocation</span>
                                    </p>
                                </div>

                                <a asp-controller="Events"
                                   asp-action="Detail"
                                   asp-route-id="@eventItem.Id"
                                   class="home-event-card__visual"
                                   aria-label="@eventItem.Title etkinliğini incele">
                                    @if (eventImage != null)
                                    {
                                        <img src="@eventImage" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="home-update-placeholder" aria-hidden="true">
                                            <i class="bi bi-calendar2-event"></i>
                                        </span>
                                    }
                                </a>
                            </article>
                        }

                        <div id="homeEventFilterEmpty"
                             class="home-updates__empty"
                             style="display: none; grid-column: 1 / -1; width: 100%;">
                            <i class="bi bi-calendar2-event" aria-hidden="true"></i>
                            <p>Bu kategoride henüz yayınlanmış etkinlik bulunmamaktadır.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="home-updates__empty">
                        <i class="bi bi-calendar2-event" aria-hidden="true"></i>
                        <p>Yeni etkinlikler hazırlandığında bu alanda yayınlanacaktır.</p>
                    </div>
                }
            </section>

            <section class="home-updates__news home-update-reveal"
                     aria-labelledby="homeNewsTitle">
                <header class="home-updates__header home-updates__header--news">
                    <h2 id="homeNewsTitle">Güncel Haberler</h2>
                </header>

                @if (Model.LatestNews.Count > 0)
                {
                    var featuredNews = Model.LatestNews[0];
                    var featuredNewsImage = string.IsNullOrWhiteSpace(featuredNews.ImageUrl)
                        ? null
                        : Url.Content(featuredNews.ImageUrl);

                    <div class="home-news-list">
                        <article class="home-news-featured">
                            <a asp-controller="News"
                               asp-action="Detail"
                               asp-route-id="@featuredNews.Id"
                               class="home-news-featured__link">
                                @if (featuredNewsImage != null)
                                {
                                    <img src="@featuredNewsImage" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="home-update-placeholder" aria-hidden="true">
                                        <i class="bi bi-newspaper"></i>
                                    </span>
                                }

                                <span class="home-news-featured__overlay" aria-hidden="true"></span>
                                <span class="home-news-featured__content">
                                    <span class="home-news-featured__meta">
                                        <span class="home-update-badge home-update-badge--news">
                                            Haber
                                        </span>
                                        <time datetime="@featuredNews.CreatedAt.ToString("yyyy-MM-dd")">
                                            @featuredNews.CreatedAt.ToString("dd MMMM yyyy", trCulture)
                                        </time>
                                    </span>
                                    <strong>@featuredNews.Title</strong>
                                    <span class="home-news-featured__summary">@featuredNews.Summary</span>
                                </span>
                            </a>
                        </article>

                        @foreach (var newsItem in Model.LatestNews.Skip(1))
                        {
                            var newsItemImage = string.IsNullOrWhiteSpace(newsItem.ImageUrl)
                                ? null
                                : Url.Content(newsItem.ImageUrl);

                            <article class="home-news-compact">
                                <a asp-controller="News"
                                   asp-action="Detail"
                                   asp-route-id="@newsItem.Id">
                                    <span class="home-news-compact__visual" aria-hidden="true">
                                        @if (newsItemImage != null)
                                        {
                                            <img src="@newsItemImage" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="home-update-placeholder">
                                                <i class="bi bi-newspaper"></i>
                                            </span>
                                        }
                                    </span>

                                    <span class="home-news-compact__content">
                                        <span class="home-news-compact__meta">
                                            <span class="home-update-badge home-update-badge--muted">
                                                Haber
                                            </span>
                                            <time datetime="@newsItem.CreatedAt.ToString("yyyy-MM-dd")">
                                                @newsItem.CreatedAt.ToString("dd MMMM yyyy", trCulture)
                                            </time>
                                        </span>
                                        <strong>@newsItem.Title</strong>
                                        <span class="home-news-compact__summary">@newsItem.Summary</span>
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </span>
                                </a>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="home-updates__empty">
                        <i class="bi bi-newspaper" aria-hidden="true"></i>
                        <p>Güncel haberler yayınlandığında bu alanda görüntülenecektir.</p>
                    </div>
                }
            </section>
        </div>
    </div>
</section>
