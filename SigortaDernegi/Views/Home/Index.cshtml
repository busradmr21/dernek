                <div class="institution-showcase__group">
                    @foreach (var institution in row2Institutions)
                    {
                        <a class="institution-card"
                           href="@institution.WebsiteUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="@institution.Name resmî internet sitesini yeni sekmede aç">
                            <span class="institution-card__mark" aria-hidden="true">
                                @institution.Abbreviation
                            </span>

                            <span class="institution-card__name">
                                @institution.Name
                            </span>
                        </a>
                    }
                </div>
                <div class="institution-showcase__group" aria-hidden="true">
                    @foreach (var institution in row2Institutions)
                    {
                        <a class="institution-card"
                           href="@institution.WebsiteUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           tabindex="-1">
                            <span class="institution-card__mark">
                                @institution.Abbreviation
                            </span>

                            <span class="institution-card__name">
                                @institution.Name
                            </span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
    </section>
}

@section Scripts {
    <script>
        (function () {
            function initHomeEventFilter() {
                var filterButtons = document.querySelectorAll('.home-event-filter-btn');
                var cards = document.querySelectorAll('#homeEventsGrid .home-event-card');
                var emptyMsg = document.getElementById('homeEventFilterEmpty');
                var allEventsLink = document.getElementById('homeAllEventsLink');

                if (!filterButtons.length || !cards.length) return;

                filterButtons.forEach(function (btn) {
                    btn.addEventListener('click', function (e) {
                        e.preventDefault();
                        var selectedFilter = (btn.getAttribute('data-event-filter') || 'all').trim();
                        var normalizedFilter = selectedFilter.toLocaleLowerCase('tr-TR');

                        filterButtons.forEach(function (b) {
                            b.classList.remove('is-active');
                            b.setAttribute('aria-pressed', 'false');
                        });
                        btn.classList.add('is-active');
                        btn.setAttribute('aria-pressed', 'true');

                        if (allEventsLink) {
                            var baseUrl = allEventsLink.getAttribute('href').split('?')[0];
                            if (normalizedFilter === 'all') {
                                allEventsLink.setAttribute('href', baseUrl);
                            } else {
                                allEventsLink.setAttribute('href', baseUrl + '?type=' + encodeURIComponent(selectedFilter));
                            }
                        }

                        var visibleCount = 0;
                        cards.forEach(function (card) {
                            var cardType = (card.getAttribute('data-event-type') || '').trim();
                            var normalizedType = cardType.toLocaleLowerCase('tr-TR');
                            var isMatch = (normalizedFilter === 'all') || (normalizedType === normalizedFilter);

                            if (isMatch && visibleCount < 3) {
                                card.style.display = '';
                                card.classList.remove('is-filtering');
                                void card.offsetWidth;
                                card.classList.add('is-filtering');
                                visibleCount++;
                            } else {
                                card.style.display = 'none';
                                card.classList.remove('is-filtering');
                            }
                        });

                        if (emptyMsg) {
                            emptyMsg.style.display = (visibleCount === 0) ? 'block' : 'none';
                        }
                    });
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initHomeEventFilter);
            } else {
                initHomeEventFilter();
            }
        })();
    </script>
}
