        <!-- 1. Sıra (İlk yarı kurumlar - Sola Akan) -->
        <div class="institution-showcase__track institution-showcase__track--row1">
            <div class="institution-showcase__group">
                @foreach (var institution in row1Institutions)
                {
                    <a class="institution-card"
                       href="@institution.WebsiteUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="@institution.Name resmî internet sitesini yeni sekmede aç">
                        <span class="institution-card__mark" aria-hidden="true">
                            @institution.Abbreviation
                        </span>

                        <span class="institution-card__name">
                            @institution.Name
                        </span>
                    </a>
                }
            </div>
            <div class="institution-showcase__group" aria-hidden="true">
                @foreach (var institution in row1Institutions)
                {
                    <a class="institution-card"
                       href="@institution.WebsiteUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       tabindex="-1">
                        <span class="institution-card__mark">
                            @institution.Abbreviation
                        </span>

                        <span class="institution-card__name">
                            @institution.Name
