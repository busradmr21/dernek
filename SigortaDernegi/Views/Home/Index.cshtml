@if (relatedInstitutions.Count > 0)
{
    var halfCount = (int)Math.Ceiling(relatedInstitutions.Count / 2.0);
    var row1Institutions = relatedInstitutions.Take(halfCount).ToList();
    var row2Institutions = relatedInstitutions.Skip(halfCount).ToList();

    <!-- İlgili kurumlar ve sektörel paydaşlar -->
    <section class="institution-showcase"
             aria-labelledby="institutionShowcaseTitle">
    <div class="container">
        <div class="institution-showcase__heading">
            <span class="institution-showcase__eyebrow">
                Kurumsal Bağlantılar
            </span>

            <h2 id="institutionShowcaseTitle">
                İlgili Kurumlar ve Sektörel Paydaşlar
            </h2>

            <p>
                Sigortacılık, eğitim, düzenleme ve sivil toplum alanındaki
                ilgili kurumların resmî internet sayfalarına hızlı erişim.
            </p>
        </div>
    </div>

    <!-- Masaüstü & Tablet: Tek sıralı orijinal şerit -->
    <div class="institution-showcase__viewport institution-showcase__viewport--desktop">
        <div class="institution-showcase__track">
            <div class="institution-showcase__group">
                @foreach (var institution in relatedInstitutions)
                {
                    <a class="institution-card"
                       href="@institution.WebsiteUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="@institution.Name resmî internet sitesini yeni sekmede aç">
                        <span class="institution-card__mark" aria-hidden="true">
                            @institution.Abbreviation
                        </span>

                        <span class="institution-card__name">
                            @institution.Name
                        </span>
                    </a>
                }
            </div>

            <div class="institution-showcase__group"
                 aria-hidden="true">
                @foreach (var institution in relatedInstitutions)
                {
                    <a class="institution-card"
                       href="@institution.WebsiteUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       tabindex="-1">
                        <span class="institution-card__mark">
                            @institution.Abbreviation
                        </span>

                        <span class="institution-card__name">
                            @institution.Name
                        </span>
                    </a>
