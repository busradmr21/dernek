<!-- İletişim ve gizli ihbar alanı -->
<section class="home-contact-report"
         id="homeContactReport"
         aria-labelledby="homeContactReportTitle">
    <div class="container">
        <header class="home-contact-report__heading">
            <span>İletişim ve Güvenli Bildirim</span>
            <h2 id="homeContactReportTitle">Size uygun kanaldan bize ulaşın</h2>
            <p>Genel başvurularınızı iletin veya şüpheli bir durumu kimlik bilgisi vermeden bildirin.</p>
        </header>

        <div class="home-contact-report__grid">
            <article class="home-form-panel home-form-panel--contact"
                     aria-labelledby="homeContactTitle">
                <div class="home-form-panel__header">
                    <span class="home-form-panel__eyebrow">
                        <i class="bi bi-chat-square-text" aria-hidden="true"></i>
                        ELSADER İletişim
                    </span>
                    <h3 id="homeContactTitle">İletişim ve Bilgi Talebi</h3>
                    <p>Üyelik süreçleri, bilgi talepleri ve kurumsal iş birlikleri hakkında bize ulaşın.</p>
                </div>

                @if (TempData["HomeContactSuccess"] is string contactSuccess)
                {
                    <div class="home-form-alert home-form-alert--success" role="status">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        <span>@contactSuccess</span>
                    </div>
                }

                <form asp-controller="Home"
                      asp-action="SubmitHomeContact"
                      method="post"
                      class="home-form">
                    <div asp-validation-summary="ModelOnly"
                         class="home-form__validation-summary"></div>
                    <div class="home-form__honeypot" aria-hidden="true">
                        <label for="contactWebsite">Bu alanı boş bırakın</label>
                        <input id="contactWebsite"
                               name="contactWebsite"
                               type="text"
                               tabindex="-1"
                               autocomplete="off" />
                    </div>

                    <div class="home-form__two-columns">
                        <div class="home-form__field">
                            <label asp-for="ContactForm.FullName"></label>
                            <input asp-for="ContactForm.FullName"
                                   autocomplete="name"
                                   placeholder="Adınız Soyadınız" />
                            <span asp-validation-for="ContactForm.FullName"></span>
                        </div>

                        <div class="home-form__field">
                            <label asp-for="ContactForm.Email"></label>
                            <input asp-for="ContactForm.Email"
                                   autocomplete="email"
                                   placeholder="ornek@eposta.com" />
                            <span asp-validation-for="ContactForm.Email"></span>
                        </div>
                    </div>

                    <div class="home-form__field">
                        <label asp-for="ContactForm.Subject"></label>
                        <select asp-for="ContactForm.Subject">
                            <option value="">Seçiniz...</option>
                            @foreach (var subject in homeContactSubjects)
                            {
                                <option value="@subject">@subject</option>
                            }
                        </select>
                        <span asp-validation-for="ContactForm.Subject"></span>
                    </div>

                    <div class="home-form__field">
                        <label asp-for="ContactForm.Message"></label>
                        <textarea asp-for="ContactForm.Message"
                                  rows="6"
                                  style="resize: none;"
                                  placeholder="İletmek istediğiniz mesajı detaylı olarak yazınız..."></textarea>
                        <span asp-validation-for="ContactForm.Message"></span>
                    </div>

                    <div class="home-form__check">
                        <input asp-for="ContactForm.HasReadKvkkNotice" />
                        <label asp-for="ContactForm.HasReadKvkkNotice">
                            <a asp-controller="Home" asp-action="Privacy" target="_blank" rel="noopener">KVKK Aydınlatma Metni</a>’ni
                            okudum ve iletişim talebim kapsamında kişisel verilerimin işlenmesi hakkında bilgi edindim.
                        </label>
                    </div>
                    <span asp-validation-for="ContactForm.HasReadKvkkNotice"
                          class="home-form__validation"></span>

                    <button type="submit" class="home-form__submit home-form__submit--contact">
                        <span>Mesaj Gönder</span>
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                </form>

                <footer class="home-form-panel__footer">
                    <span><i class="bi bi-telephone" aria-hidden="true"></i> @contactSettings.PhoneDisplay</span>
                    <span><i class="bi bi-envelope" aria-hidden="true"></i> @contactSettings.Email</span>
                </footer>
            </article>

            <article class="home-form-panel home-form-panel--report"
                     aria-labelledby="homeReportTitle">
                <div class="home-form-panel__header home-form-panel__header--report">
                    <div>
