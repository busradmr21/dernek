@using System.Globalization
@model SigortaDernegi.Models.News

@{
    ViewData["Title"] = Model.Title;
    var culture = new CultureInfo("tr-TR");

    var contentType = Model.IsAnnouncement
        ? "Duyuru"
        : "Haber";

    var listAction = Model.IsAnnouncement
        ? "Announcements"
        : "Index";

    var listTitle = Model.IsAnnouncement
        ? "Tüm Duyurulara Dön"
        : "Tüm Haberlere Dön";

    var paragraphs = Model.Content.Split(
        new[] { "\r\n\r\n", "\n\n" },
        StringSplitOptions.RemoveEmptyEntries);

    var createdLocal = Model.CreatedAt.ToLocalTime();
    var startDay = createdLocal.ToString("dd");
    var startMonth = createdLocal.ToString("MMMM", culture);
    var startYear = createdLocal.ToString("yyyy");
    var startDayName = createdLocal.ToString("dddd", culture);
}

<main class="event-detail-page py-4 py-lg-5">
    <div class="container">

        <!-- Üst Gezinme / Geri Dön -->
        <nav class="event-detail__nav mb-4" aria-label="Gezinme">
            <a asp-controller="News"
               asp-action="@listAction"
               class="event-detail__back-btn">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                <span>@listTitle</span>
            </a>
            <span class="event-detail__nav-divider">/</span>
            <span class="event-detail__nav-current text-truncate">@Model.Title</span>
        </nav>

        <div class="row g-4 g-xl-5">

            <!-- Sol Kolon: Ana İçerik ve Görsel (col-lg-8) -->
            <div class="col-12 col-lg-8">

                <!-- Başlık ve Rozetler -->
                <header class="event-detail__header mb-4">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="event-badge @(Model.IsAnnouncement ? "event-badge--announcement" : "event-badge--category")">
                            <i class="bi @(Model.IsAnnouncement ? "bi-megaphone-fill" : "bi-newspaper") me-1" aria-hidden="true"></i>
                            @(Model.IsAnnouncement ? "Resmî Duyuru" : "Sektörel Haber")
                        </span>

                        <span class="event-badge event-badge--upcoming">
                            <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>
                            @createdLocal.ToString("dd MMMM yyyy", culture)
                        </span>

                        <span class="event-badge event-badge--online">
                            <i class="bi bi-clock me-1" aria-hidden="true"></i>
                            @createdLocal.ToString("HH:mm")
                        </span>
                    </div>

                    <h1 class="event-detail__title">@Model.Title</h1>

                    @if (!string.IsNullOrWhiteSpace(Model.Summary))
                    {
                        <p class="event-detail__lead">@Model.Summary</p>
                    }
                </header>

                <!-- Haber / Duyuru Görseli (Orantılı, net, sınırlandırılmış) -->
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <div class="event-detail__media-wrapper mb-4">
                        <img src="@Model.ImageUrl"
                             alt="@Model.Title"
                             class="event-detail__media-img" />
                    </div>
                }

                <!-- Metin İçeriği Kartı -->
                <article class="event-detail__content-card p-4 p-md-5 mb-4">
                    <h2 class="event-detail__section-title">
                        <i class="bi bi-file-earmark-text me-2" aria-hidden="true"></i>
                        @(Model.IsAnnouncement ? "Duyuru Metni" : "Haber Detayı")
                    </h2>

                    <div class="event-detail__richtext">
                        @foreach (var paragraph in paragraphs)
                        {
                            var paragraphText = paragraph.Trim();
                            var sourcePrefix = "Kaynak:";

                            if (paragraphText.StartsWith(sourcePrefix, StringComparison.OrdinalIgnoreCase) &&
                                Uri.TryCreate(paragraphText[sourcePrefix.Length..].Trim(), UriKind.Absolute, out var sourceUrl))
                            {
                                <div class="news-source-card mt-4 p-3 rounded-3 border bg-light d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-link-45deg text-primary fs-5"></i>
                                        <span class="small fw-semibold text-secondary">Resmî Kaynak / Referans Belge:</span>
                                    </div>
                                    <a href="@sourceUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                                        <span>@sourceUrl.Host</span>
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                </div>
                            }
                            else
                            {
                                <p>@paragraphText</p>
                            }
                        }
                    </div>

                    <div class="event-detail__cta-box mt-4 pt-4 border-top">
                        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-2 text-secondary small">
                                <i class="bi bi-shield-check text-success fs-5"></i>
                                <span>Bu içerik <strong>ELSADER</strong> tarafından doğrulanarak yayımlanmıştır.</span>
                            </div>
                            <a asp-controller="News"
                               asp-action="@listAction"
                               class="event-detail__register-btn">
                                <span>@(Model.IsAnnouncement ? "Diğer Duyurular" : "Diğer Haberler")</span>
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </article>

            </div>

            <!-- Sağ Kolon: Yapışkan Bilgi Kartı (col-lg-4) -->
            <div class="col-12 col-lg-4">
                <aside class="event-detail__sidebar">

                    <div class="event-detail__info-card">

                        <!-- Takvim Vurgu Başlığı -->
                        <div class="event-detail__date-hero">
                            <div class="event-detail__date-stamp">
                                <span class="event-detail__date-stamp-day">@startDay</span>
                                <span class="event-detail__date-stamp-month">@startMonth</span>
                            </div>
                            <div class="event-detail__date-hero-text">
                                <span class="event-detail__date-dayname">@startDayName</span>
                                <span class="event-detail__date-full">@createdLocal.ToString("dd MMMM yyyy", culture)</span>
                            </div>
                        </div>

                        <!-- Bilgi Maddeleri -->
                        <div class="event-detail__info-list">

                            <div class="event-detail__info-item">
                                <div class="event-detail__info-icon">
                                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                                </div>
                                <div>
                                    <span class="event-detail__info-label">Yayın Saati</span>
                                    <strong class="event-detail__info-value">@createdLocal.ToString("HH:mm")</strong>
                                </div>
                            </div>

                            <div class="event-detail__info-item">
                                <div class="event-detail__info-icon">
                                    <i class="bi @(Model.IsAnnouncement ? "bi-megaphone" : "bi-newspaper")" aria-hidden="true"></i>
                                </div>
                                <div>
                                    <span class="event-detail__info-label">İçerik Türü</span>
                                    <strong class="event-detail__info-value">@(Model.IsAnnouncement ? "Resmî Kurumsal Duyuru" : "Sektörel Haber")</strong>
                                </div>
                            </div>

                            <div class="event-detail__info-item">
                                <div class="event-detail__info-icon">
                                    <i class="bi bi-building-check" aria-hidden="true"></i>
                                </div>
                                <div>
                                    <span class="event-detail__info-label">Yayımlayan Birim</span>
                                    <strong class="event-detail__info-value">
                                        @(Model.IsAnnouncement ? "ELSADER Genel Sekreterliği" : "ELSADER Basın Masası")
                                    </strong>
                                </div>
                            </div>

                        </div>

                        <!-- Diğer Bölümlere Hızlı Geçiş -->
                        <div class="d-flex flex-column gap-2 mb-3">
                            @if (Model.IsAnnouncement)
                            {
                                <a asp-controller="News"
                                   asp-action="Index"
                                   class="event-detail__sidebar-btn">
                                    <i class="bi bi-newspaper me-1"></i>
                                    <span>Güncel Haberleri İncele</span>
                                </a>
                            }
                            else
                            {
                                <a asp-controller="News"
                                   asp-action="Announcements"
                                   class="event-detail__sidebar-btn">
                                    <i class="bi bi-megaphone me-1"></i>
                                    <span>Kurumsal Duyuruları İncele</span>
                                </a>
                            }

                            <a asp-controller="Events"
                               asp-action="Index"
                               class="event-detail__sidebar-outline-btn">
                                <i class="bi bi-calendar2-event me-1"></i>
                                <span>Etkinlik Takvimine Git</span>
                            </a>
                        </div>

                        <!-- Dernek Destek Notu -->
                        <div class="event-detail__support-note">
                            <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                            <span>Resmî açıklamalar ve basın bültenleri için ELSADER iletişim kanallarını kullanabilirsiniz.</span>
                        </div>

                    </div>

                </aside>
            </div>

        </div>

    </div>
</main>
