@using System.Globalization
@model IReadOnlyList<News>
@{
    ViewData["Title"] = "Haberler ve Duyurular";
    var culture = CultureInfo.GetCultureInfo("tr-TR");
    var canAdd = await RolePermissionService.HasPermissionAsync(User, ManagementArea.HomeUpdates, PermissionActionType.Add);
    var canEdit = await RolePermissionService.HasPermissionAsync(User, ManagementArea.HomeUpdates, PermissionActionType.Edit);
    var canApprove = await RolePermissionService.HasPermissionAsync(User, ManagementArea.HomeUpdates, PermissionActionType.Approve);
    var canDelete = await RolePermissionService.HasPermissionAsync(User, ManagementArea.HomeUpdates, PermissionActionType.Delete);
}

<section class="admin-module content-admin-page">
    <div class="admin-module__header">
        <div>
            <span class="admin-module__eyebrow">Ana Sayfa Akışı</span>
            <h1>Haberler ve Duyurular</h1>
            <p>Aktif haberlerin en yeni üç kaydı, duyurular hariç tutularak ana sayfadaki Güncel Haberler alanında gösterilir.</p>
        </div>
        @if (canAdd)
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Yeni İçerik</a>
        }
    </div>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="admin-feedback admin-feedback--success" role="status"><i class="bi bi-check-circle-fill"></i><span>@message</span></div>
    }

    <div class="content-admin-list">
        @foreach (var item in Model)
        {
            <article class="content-admin-card">
                <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/news/news-default.jpg" : Url.Content(item.ImageUrl))" alt="" />
                <div class="content-admin-card__body">
                    <div class="content-admin-card__meta">
                        <span class="content-admin-type">@(item.IsAnnouncement ? "Duyuru" : "Haber")</span>
                        <time>@item.CreatedAt.ToString("dd MMMM yyyy", culture)</time>
                    </div>
                    <h2>@item.Title</h2>
                    <p>@item.Summary</p>
                </div>
                <span class="admin-status-button @(item.IsActive ? "admin-status-button--active" : "admin-status-button--passive")">@(item.IsActive ? "Yayında" : "Pasif")</span>
                <div class="content-admin-card__actions">
                    @if (canEdit)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil-square"></i> Düzenle</a>
                    }
                    @if (canApprove)
                    {
                        <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post">
                            <button type="submit" class="btn btn-outline-secondary"><i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye")"></i></button>
                        </form>
                    }
                    @if (canDelete)
                    {
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu içeriği kalıcı olarak silmek istediğinize emin misiniz?');">
                            <button type="submit" class="content-admin-delete" aria-label="@item.Title içeriğini sil"><i class="bi bi-trash3"></i></button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
</section>
