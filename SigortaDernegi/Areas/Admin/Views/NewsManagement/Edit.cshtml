@model SigortaDernegi.Areas.Admin.ViewModels.NewsFormViewModel
@{ ViewData["Title"] = "Haberi veya Duyuruyu Düzenle"; }
<section class="admin-module"><div class="admin-module__header"><div><span class="admin-module__eyebrow">Haber Yönetimi</span><h1>İçeriği Düzenle</h1><p>Metin, görsel, tarih, tür ve yayın durumunu güncelleyin.</p></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="admin-form-card"><partial name="_Form" model="Model" /><div class="admin-form-actions"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Değişiklikleri Kaydet</button><a asp-action="Index" class="btn btn-outline-secondary">İptal</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/admin-slider-form.js" asp-append-version="true"></script> }
