@model IReadOnlyList<BoardMember>

@using SigortaDernegi.Areas.Admin.Authorization
@using SigortaDernegi.Data
@inject IRolePermissionService PermissionService

@{
    ViewData["Title"] = "Yönetim Kurulu";

    var canAdd = await PermissionService.HasPermissionAsync(
        User,
        ManagementArea.BoardManagement,
        PermissionActionType.Add);

    var canEdit = await PermissionService.HasPermissionAsync(
        User,
        ManagementArea.BoardManagement,
        PermissionActionType.Edit);

    var canApprove = await PermissionService.HasPermissionAsync(
        User,
        ManagementArea.BoardManagement,
        PermissionActionType.Approve);

    var canDelete = await PermissionService.HasPermissionAsync(
        User,
        ManagementArea.BoardManagement,
        PermissionActionType.Delete);

    var isAdmin = User.IsInRole(IdentitySeedData.AdminRole);
}

@functions {
    private static string GetPositionName(BoardPosition position)
    {
        return position switch
        {
            BoardPosition.President => "Dernek Başkanı",
            BoardPosition.VicePresident => "Başkan Yardımcısı",
            BoardPosition.Treasurer => "Sayman",
            BoardPosition.GeneralSecretary => "Genel Sekreter",
            _ => "Yönetim Kurulu Üyesi"
        };
    }
}

<section class="admin-module board-admin-page">
    <div class="admin-module__header">
        <div>
            <span class="admin-module__eyebrow">
                Üye Yönetimi
            </span>

            <h1>Yönetim Kurulu</h1>

            <p>
                Dernek başkanı, başkan yardımcısı, sayman ve
                genel sekreter bilgilerini yönetin.
            </p>
        </div>

        @if (canAdd)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus"></i>
                Yeni Yönetim Üyesi
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="admin-feedback admin-feedback--success"
             role="status">
            <i class="bi bi-check-circle-fill"></i>
            <span>@message</span>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (Model.Count == 0)
    {
        <div class="board-admin-empty">
            <i class="bi bi-people"></i>

            <h2>Henüz dernek yönetim üyesi eklenmedi</h2>

            <p>
                İlk yönetim kurulu üyesini ekleyerek
                bu bölümü oluşturmaya başlayabilirsiniz.
            </p>

            @if (canAdd)
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    İlk Üyeyi Ekle
                </a>
            }
        </div>
    }
    else
    {
        <div class="board-admin-list">
            @foreach (var member in Model)
            {
                <article class="board-admin-card">
                    <div class="board-admin-card__photo">
                        @if (!string.IsNullOrWhiteSpace(member.PhotoUrl))
                        {
                            <img src="@Url.Content(member.PhotoUrl)"
                                 alt="@member.FullName" />
                        }
                        else
                        {
                            <div class="board-admin-card__placeholder">
                                <i class="bi bi-person"></i>
                            </div>
                        }
                    </div>

                    <div class="board-admin-card__content">
                        <span class="board-admin-card__position">
                            @GetPositionName(member.Position)
                        </span>

                        <h2>@member.FullName</h2>

                        @if (!string.IsNullOrWhiteSpace(
                       member.ProfessionalTitle))
                        {
                            <p class="board-admin-card__title">
                                @member.ProfessionalTitle
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(member.Biography))
                        {
                            <p class="board-admin-card__bio" style="margin: 4px 0 8px 0; font-size: 13px; color: #64748b; font-style: italic;">
                                @member.Biography
                            </p>
                        }

                        <div class="board-admin-card__dates">
                            <span>
                                <i class="bi bi-calendar-check"></i>
                                Başlangıç:
                                @member.TermStart.ToString("dd.MM.yyyy")
                            </span>

                            @if (member.TermEnd.HasValue)
                            {
                                <span>
                                    <i class="bi bi-calendar-x"></i>
                                    Bitiş:
                                    @member.TermEnd.Value.ToString("dd.MM.yyyy")
                                </span>
                            }
                        </div>
                    </div>

                    <div class="board-admin-card__status">
                        <span class="admin-status-button
                            @(member.IsActive
                                ? "admin-status-button--active"
                                : "admin-status-button--passive")">
                            @(member.IsActive
                                ? "Aktif görevde"
                                : "Görevi sona erdi")
                        </span>

                        <span class="admin-status-button
                            @(member.IsPublished
                                ? "admin-status-button--active"
                                : "admin-status-button--passive")">
                            @(member.IsPublished
                                ? "Sitede görünüyor"
                                : "Sitede gizli")
                        </span>

                        <span class="admin-status-button
                            @(member.IdentityUserId != null
                                ? "admin-status-button--active"
                                : "admin-status-button--passive")">
                            @(member.IdentityUserId != null
                                ? "Hesap bağlı"
                                : "Hesap yok")
                        </span>
                    </div>

                    <div class="board-admin-card__actions">
                        @if (canEdit || isAdmin)
                        {
                            <a asp-action="Details"
                               asp-route-id="@member.Id"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-person-lines-fill"></i>
                                Detay
                            </a>
                        }

                        @if (canApprove)
                        {
                            <form asp-action="ToggleStatus"
                                  asp-route-id="@member.Id"
                                  method="post">
                                <button type="submit"
                                        class="btn btn-outline-secondary"
                                        title="Site görünürlüğünü değiştir">
                                    <i class="bi
                                        @(member.IsPublished
                                            ? "bi-eye-slash"
                                            : "bi-eye")">
                                    </i>
                                </button>
                            </form>
                        }

                        @if (canDelete)
                        {
                            <form asp-action="Delete"
                                  asp-route-id="@member.Id"
                                  method="post"
                                  onsubmit="return confirm(
                                  'Bu dernek yönetim üyesini kalıcı olarak silmek istediğinize emin misiniz?');">

                                <button type="submit"
                                        class="content-admin-delete"
                                        aria-label="@member.FullName kişisini sil">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
