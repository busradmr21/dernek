@model SigortaDernegi.Areas.Admin.ViewModels.BoardMemberFormViewModel

@{
    ViewData["Title"] = "Yeni Dernek Yönetim Üyesi";
}

<section class="admin-module">
    <div class="admin-module__header">
        <div>
            <span class="admin-module__eyebrow">
                Yönetim Kurulu
            </span>

            <h1>Yeni Dernek Yönetim Üyesi</h1>

            <p>
                Dernek yönetim üyesinin kişisel bilgilerini,
                görevini ve site görünürlüğünü belirleyin.
            </p>
        </div>
    </div>

    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data"
          class="admin-form-card">

        <partial name="_Form" model="Model" />

        <div class="admin-form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i>
                Üyeyi Kaydet
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                İptal
            </a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/admin-slider-form.js"
            asp-append-version="true">
    </script>
}
