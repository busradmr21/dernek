@model SigortaDernegi.Areas.Admin.ViewModels.MultimediaFormViewModel
<input asp-for="Id" type="hidden" /><input asp-for="ExistingImageUrl" type="hidden" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="admin-form-grid">
    <div class="admin-form-field admin-form-field--full"><label class="form-label">İçerik Türü</label><div class="admin-form-switch"><input asp-for="IsGallery" class="form-check-input" /><label asp-for="IsGallery">Foto galeride göster</label></div><div class="admin-form-help">İşaretliyse foto galeride, işaretli değilse Basında Biz bölümünde yayınlanır.</div></div>
    <div class="admin-form-field"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select"><option value="">Seçiniz</option><option>Basın Açıklaması</option><option>Röportaj</option><option>Sektör Gündemi</option><option>Uzman Görüşü</option></select><span asp-validation-for="Category" class="text-danger"></span></div>
    <div class="admin-form-field"><label asp-for="PublishedAt" class="form-label"></label><input asp-for="PublishedAt" type="datetime-local" class="form-control" /></div>
    <div class="admin-form-field admin-form-field--full"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
    <div class="admin-form-field admin-form-field--full"><label asp-for="Summary" class="form-label"></label><textarea asp-for="Summary" rows="3" class="form-control"></textarea><span asp-validation-for="Summary" class="text-danger"></span></div>
    <div class="admin-form-field admin-form-field--full"><label asp-for="Content" class="form-label"></label><textarea asp-for="Content" rows="12" class="form-control"></textarea><div class="admin-form-help">Basın içeriğinde zorunludur. Foto galeri öğesinde boş bırakabilirsiniz. Yeni paragraf için arada bir boş satır bırakın.</div><span asp-validation-for="Content" class="text-danger"></span></div>
    <div class="admin-form-field admin-form-field--full"><label asp-for="ImageFile" class="form-label"></label><div class="admin-image-field"><div class="admin-image-preview" data-slider-image-preview><img src="@(string.IsNullOrWhiteSpace(Model.ExistingImageUrl) ? "" : Url.Content(Model.ExistingImageUrl))" alt="Görsel ön izlemesi" class="@(string.IsNullOrWhiteSpace(Model.ExistingImageUrl) ? "d-none" : "")" data-slider-preview-image /><div class="admin-image-preview__placeholder @(string.IsNullOrWhiteSpace(Model.ExistingImageUrl) ? "" : "d-none")" data-slider-preview-placeholder><i class="bi bi-image"></i><span>Görsel ön izlemesi</span></div></div><div><input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" data-slider-image-input /><div class="admin-form-help">JPG, PNG veya WEBP; en fazla 5 MB.</div><span asp-validation-for="ImageFile" class="text-danger"></span></div></div></div>
    <div class="admin-form-field"><label asp-for="SourceName" class="form-label"></label><input asp-for="SourceName" class="form-control" /></div>
    <div class="admin-form-field"><label asp-for="SourceUrl" class="form-label"></label><input asp-for="SourceUrl" class="form-control" placeholder="https://..." /><span asp-validation-for="SourceUrl" class="text-danger"></span></div>
    <div class="admin-form-field"><label class="form-label">Yayın Durumu</label><div class="admin-form-switch"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive">Sitede yayınlansın</label></div></div>
</div>
