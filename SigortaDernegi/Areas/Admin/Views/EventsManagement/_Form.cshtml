@model SigortaDernegi.Areas.Admin.ViewModels.EventFormViewModel
<input asp-for="Id" type="hidden" /><input asp-for="ExistingImageUrl" type="hidden" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="admin-form-grid">
    <div class="admin-form-field admin-form-field--full"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
    <div class="admin-form-field admin-form-field--full"><label asp-for="Summary" class="form-label"></label><textarea asp-for="Summary" rows="3" class="form-control"></textarea><span asp-validation-for="Summary" class="text-danger"></span></div>
    <div class="admin-form-field admin-form-field--full"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="9" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
    <div class="admin-form-field admin-form-field--full"><label asp-for="ImageFile" class="form-label"></label><div class="admin-image-field"><div class="admin-image-preview" data-slider-image-preview><img src="@(string.IsNullOrWhiteSpace(Model.ExistingImageUrl) ? "" : Url.Content(Model.ExistingImageUrl))" alt="Görsel ön izlemesi" class="@(string.IsNullOrWhiteSpace(Model.ExistingImageUrl) ? "d-none" : "")" data-slider-preview-image /><div class="admin-image-preview__placeholder @(string.IsNullOrWhiteSpace(Model.ExistingImageUrl) ? "" : "d-none")" data-slider-preview-placeholder><i class="bi bi-image"></i><span>Görsel ön izlemesi</span></div></div><div><input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" data-slider-image-input /><div class="admin-form-help">JPG, PNG veya WEBP; en fazla 5 MB.</div><span asp-validation-for="ImageFile" class="text-danger"></span></div></div></div>
    <div class="admin-form-field"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" type="datetime-local" class="form-control" /><span asp-validation-for="StartDate" class="text-danger"></span></div>
    <div class="admin-form-field"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" type="datetime-local" class="form-control" /><span asp-validation-for="EndDate" class="text-danger"></span></div>
    <div class="admin-form-field"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option value="">Seçiniz</option><option>Seminer</option><option>Webinar</option><option>Eğitim</option><option>Söyleşi</option><option>Toplantı</option></select></div>
    <div class="admin-form-field"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /></div>
    <div class="admin-form-field admin-form-field--full"><label asp-for="RegistrationUrl" class="form-label"></label><input asp-for="RegistrationUrl" class="form-control" placeholder="https://..." /><span asp-validation-for="RegistrationUrl" class="text-danger"></span></div>
    <div class="admin-form-field"><label class="form-label">Seçenekler</label><div class="admin-form-switch"><input asp-for="IsOnline" class="form-check-input" /><label asp-for="IsOnline">Çevrim içi etkinlik</label></div><div class="admin-form-switch mt-2"><input asp-for="IsFeatured" class="form-check-input" /><label asp-for="IsFeatured">Öne çıkan etkinlik</label></div></div>
    <div class="admin-form-field"><label class="form-label">Yayın Durumu</label><div class="admin-form-switch"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive">Sitede yayınlansın</label></div></div>
</div>
