@model SigortaDernegi.Areas.Admin.ViewModels.SliderFormViewModel

@{
    ViewData["Title"] = "Slider Düzenle";
}

<section class="admin-form-page">
    <div class="admin-form-page__header">
        <span class="admin-module__eyebrow">Ana Sayfa Yönetimi</span>
        <h1>Slider Düzenle</h1>
        <p>Slider içeriğini, görselini, sırasını ve yayın durumunu güncelleyin.</p>
    </div>

    <form asp-area="Admin"
          asp-controller="Sliders"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          enctype="multipart/form-data"
          class="admin-form-card">

        <partial name="_SliderForm" model="Model" />

        <div class="admin-form-actions">
            <a asp-area="Admin"
               asp-controller="Sliders"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Listeye Dön
            </a>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg" aria-hidden="true"></i>
                Değişiklikleri Kaydet
            </button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-slider-form.js" asp-append-version="true"></script>
}
