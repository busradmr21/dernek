@model IReadOnlyList<Slider>

@{
    ViewData["Title"] = "Slider Yönetimi";
    var activeSliderCount = Model.Count(slider => slider.IsActive);
    var canAdd = await RolePermissionService.HasPermissionAsync(User, ManagementArea.SiteContent, PermissionActionType.Add);
    var canEdit = await RolePermissionService.HasPermissionAsync(User, ManagementArea.SiteContent, PermissionActionType.Edit);
    var canApprove = await RolePermissionService.HasPermissionAsync(User, ManagementArea.SiteContent, PermissionActionType.Approve);
    var canDelete = await RolePermissionService.HasPermissionAsync(User, ManagementArea.SiteContent, PermissionActionType.Delete);
}

<section class="admin-module">
    <div class="admin-module__header">
        <div>
            <span class="admin-module__eyebrow">Ana Sayfa Yönetimi</span>
            <h1>Slider Yönetimi</h1>
            <p>
                Ana sayfadaki karşılama alanını, görselleri ve bağlantıları
                buradan yönetin.
            </p>
        </div>

        <div class="admin-module__header-actions">
            <a asp-area="Admin"
               asp-controller="Sliders"
               asp-action="History"
               class="btn btn-outline-secondary">
                <i class="bi bi-clock-history" aria-hidden="true"></i>
                Değişiklik Geçmişi
            </a>

            @if (canAdd)
            {
                <a asp-area="Admin"
                   asp-controller="Sliders"
                   asp-action="Create"
                   class="btn btn-primary">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    Yeni Slider Ekle
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="admin-feedback admin-feedback--success" role="status">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            <span>@successMessage</span>
        </div>
    }

    <div class="admin-summary-grid">
        <a asp-area="Admin"
           asp-controller="Sliders"
           asp-action="Index"
           class="admin-module__summary admin-summary-filter active"
           data-filter="all"
           role="button"
           title="Tüm slider kayıtlarını listele">
            <i class="bi bi-images" aria-hidden="true"></i>
            <div>
                <span>Toplam Slider</span>
                <strong>@Model.Count</strong>
            </div>
        </a>

        <a asp-area="Admin"
           asp-controller="Sliders"
           asp-action="Index"
           asp-route-status="active"
           class="admin-module__summary admin-summary-filter"
           data-filter="active"
           role="button"
           title="Yalnızca yayında olan sliderları listele">
            <i class="bi bi-broadcast" aria-hidden="true"></i>
            <div>
                <span>Yayındaki Slider</span>
                <strong>@activeSliderCount</strong>
            </div>
        </a>

        <a asp-area="Admin"
           asp-controller="Sliders"
           asp-action="Index"
           asp-route-status="passive"
           class="admin-module__summary admin-summary-filter"
           data-filter="passive"
           role="button"
           title="Yalnızca pasif olan sliderları listele">
            <i class="bi bi-eye-slash" aria-hidden="true"></i>
            <div>
                <span>Pasif Slider</span>
                <strong>@(Model.Count - activeSliderCount)</strong>
            </div>
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="admin-module__empty">
            <i class="bi bi-image" aria-hidden="true"></i>
            <h2>Henüz slider eklenmemiş</h2>
            <p>Ana sayfada göstermek için ilk slider kaydınızı oluşturabilirsiniz.</p>
        </div>
    }
    else
    {
        <div class="admin-module__table-wrapper admin-slider-table-wrapper">
            <table class="table align-middle mb-0 admin-slider-table">
                <thead>
                    <tr>
                        <th>Görsel</th>
                        <th>İçerik</th>
                        <th>Buton</th>
                        <th>Sıra</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slider in Model)
                    {
                        <tr class="admin-slider-row" data-status="@(slider.IsActive ? "active" : "passive")">
                            <td>
                                @if (!string.IsNullOrWhiteSpace(slider.ImageUrl))
                                {
                                    <img src="@Url.Content(slider.ImageUrl)"
                                         alt=""
                                         class="admin-slider-thumbnail" />
                                }
                                else
                                {
                                    <div class="admin-slider-placeholder">
                                        <i class="bi bi-image" aria-hidden="true"></i>
                                    </div>
                                }
                            </td>
                            <td class="admin-slider-content-cell">
                                <strong>@slider.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(slider.Description))
                                {
                                    <small>@slider.Description</small>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(slider.ButtonText))
                                {
                                    <span class="admin-link-preview">
                                        <i class="bi bi-link-45deg" aria-hidden="true"></i>
                                        @slider.ButtonText
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">Buton yok</span>
                                }
                            </td>
                            <td><strong>@slider.Order</strong></td>
                            <td>
                                @if (canApprove)
                                {
                                    <form asp-area="Admin"
                                          asp-controller="Sliders"
                                          asp-action="ToggleStatus"
                                          asp-route-id="@slider.Id"
                                          method="post">
                                        <button type="submit"
                                                class="admin-status-button @(slider.IsActive ? "admin-status-button--active" : "admin-status-button--passive")"
                                                title="Yayın durumunu değiştir">
                                            <i class="bi @(slider.IsActive ? "bi-eye-fill" : "bi-eye-slash-fill")"
                                               aria-hidden="true"></i>
                                            @(slider.IsActive ? "Yayında" : "Pasif")
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="admin-status-button @(slider.IsActive ? "admin-status-button--active" : "admin-status-button--passive")">
                                        <i class="bi @(slider.IsActive ? "bi-eye-fill" : "bi-eye-slash-fill")"
                                           aria-hidden="true"></i>
                                        @(slider.IsActive ? "Yayında" : "Pasif")
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="admin-table-actions">
                                    <a asp-area="Admin"
                                       asp-controller="Sliders"
                                       asp-action="History"
                                       asp-route-sliderId="@slider.Id"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="Bu sliderın değişiklik geçmişi">
                                        <i class="bi bi-clock-history" aria-hidden="true"></i>
                                        Geçmiş
                                    </a>

                                    @if (canEdit)
                                    {
                                        <a asp-area="Admin"
                                           asp-controller="Sliders"
                                           asp-action="Edit"
                                           asp-route-id="@slider.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                            Düzenle
                                        </a>
                                    }

                                    @if (canDelete)
                                    {
                                        <a asp-area="Admin"
                                           asp-controller="Sliders"
                                           asp-action="Delete"
                                           asp-route-id="@slider.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                            Sil
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    <tr id="emptyFilterRow" style="display: none;">
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-funnel text-teal-600 fs-1 d-block mb-2"></i>
                            <strong class="d-block text-dark fs-6" id="emptyFilterTitle">Bu filtreye uygun slider bulunamadı.</strong>
                            <span class="small">Filtreyi değiştirmek için yukarıdaki kartlara tıklayabilirsiniz.</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const filterCards = document.querySelectorAll('.admin-summary-filter');
            const rows = document.querySelectorAll('.admin-slider-row');
            const emptyRow = document.getElementById('emptyFilterRow');
            const emptyTitle = document.getElementById('emptyFilterTitle');

            function applyFilter(filter, updateUrl) {
                filterCards.forEach(card => {
                    const cardFilter = card.getAttribute('data-filter');
                    if (cardFilter === filter) {
                        card.classList.add('active');
                        card.setAttribute('aria-pressed', 'true');
                    } else {
                        card.classList.remove('active');
                        card.setAttribute('aria-pressed', 'false');
                    }
                });

                let visibleCount = 0;
                rows.forEach(row => {
                    const status = row.getAttribute('data-status');
                    if (filter === 'all' || status === filter) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (emptyRow) {
                    if (visibleCount === 0) {
                        emptyRow.style.display = '';
                        if (filter === 'active') {
                            emptyTitle.textContent = 'Şu an yayında olan slider bulunmuyor.';
                        } else if (filter === 'passive') {
                            emptyTitle.textContent = 'Şu an pasif durumda olan slider bulunmuyor.';
                        } else {
                            emptyTitle.textContent = 'Kayıtlı slider bulunamadı.';
                        }
                    } else {
                        emptyRow.style.display = 'none';
                    }
                }

                if (updateUrl && window.history && window.history.replaceState) {
                    const url = new URL(window.location.href);
                    if (filter === 'all') {
                        url.searchParams.delete('status');
                    } else {
                        url.searchParams.set('status', filter);
                    }
                    window.history.replaceState({}, '', url.toString());
                }
            }

            filterCards.forEach(card => {
                card.addEventListener('click', function (e) {
                    e.preventDefault();
                    const filter = this.getAttribute('data-filter') || 'all';
                    applyFilter(filter, true);
                });
            });

            const urlParams = new URLSearchParams(window.location.search);
            const initialStatus = urlParams.get('status');
            if (initialStatus && (initialStatus === 'active' || initialStatus === 'passive' || initialStatus === 'all')) {
                applyFilter(initialStatus, false);
            }
        });
    </script>
}
