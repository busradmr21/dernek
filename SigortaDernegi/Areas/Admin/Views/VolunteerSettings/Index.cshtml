@using System.Globalization
@model SigortaDernegi.Areas.Admin.ViewModels.VolunteerSettingsAdminViewModel
@{
    ViewData["Title"] = "Gönüllülük Sayfası";
    var culture = CultureInfo.GetCultureInfo("tr-TR");
    var canEdit = await RolePermissionService.HasPermissionAsync(User, ManagementArea.SiteContent, PermissionActionType.Edit);
    var canDelete = await RolePermissionService.HasPermissionAsync(User, ManagementArea.SiteContent, PermissionActionType.Delete);
}

<section class="admin-module volunteer-settings-admin">
    <div class="admin-module__header"><div><span class="admin-module__eyebrow">Gönüllülük Yönetimi</span><h1>Gönüllülük Sayfası</h1><p>Ana sayfa kartını, gönüllülük bilgilerini, katkı alanlarını ve başvuru formunu yönetin.</p></div><a asp-area="" asp-controller="Home" asp-action="Volunteer" target="_blank" class="btn btn-outline-secondary"><i class="bi bi-box-arrow-up-right"></i> Sayfayı Gör</a></div>
    @if (TempData["SuccessMessage"] is string message) { <div class="admin-feedback admin-feedback--success"><i class="bi bi-check-circle-fill"></i><span>@message</span></div> }

    <form asp-action="Save" method="post" class="admin-form-card">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <fieldset class="admin-form-section"><legend>Sayfa Karşılama Alanı</legend><div class="admin-form-grid">
            <div class="admin-form-field"><label asp-for="Settings.HeroEyebrow" class="form-label"></label><input asp-for="Settings.HeroEyebrow" class="form-control" /></div>
            <div class="admin-form-field"><label asp-for="Settings.HeroTitle" class="form-label"></label><input asp-for="Settings.HeroTitle" class="form-control" /></div>
            <div class="admin-form-field admin-form-field--full"><label asp-for="Settings.HeroDescription" class="form-label"></label><textarea asp-for="Settings.HeroDescription" rows="3" class="form-control"></textarea></div>
        </div></fieldset>

        <fieldset class="admin-form-section"><legend>Ana Sayfadaki Gönüllü Kartı</legend><div class="admin-form-grid">
            <div class="admin-form-field"><label asp-for="Settings.HomeCardTitle" class="form-label"></label><input asp-for="Settings.HomeCardTitle" class="form-control" /></div>
            <div class="admin-form-field"><label asp-for="Settings.HomeCardDescription" class="form-label"></label><textarea asp-for="Settings.HomeCardDescription" rows="3" class="form-control"></textarea></div>
        </div></fieldset>

        <fieldset class="admin-form-section"><legend>Bilgilendirme İçeriği</legend><div class="admin-form-grid">
            <div class="admin-form-field"><label asp-for="Settings.WhoCanApplyTitle" class="form-label"></label><input asp-for="Settings.WhoCanApplyTitle" class="form-control" /></div>
            <div class="admin-form-field"><label asp-for="Settings.WhoCanApplyDescription" class="form-label"></label><textarea asp-for="Settings.WhoCanApplyDescription" rows="4" class="form-control"></textarea></div>
            <div class="admin-form-field admin-form-field--full"><label asp-for="Settings.OpportunityAreas" class="form-label"></label><textarea asp-for="Settings.OpportunityAreas" rows="7" class="form-control"></textarea><div class="admin-form-help">Her satıra bir katkı alanı yazın. Başvuru formunun seçenekleri buradan oluşturulur.</div></div>
            <div class="admin-form-field"><label asp-for="Settings.Benefits" class="form-label"></label><textarea asp-for="Settings.Benefits" rows="6" class="form-control"></textarea><div class="admin-form-help">Her satıra bir madde yazın.</div></div>
            <div class="admin-form-field"><label asp-for="Settings.ProcessSteps" class="form-label"></label><textarea asp-for="Settings.ProcessSteps" rows="6" class="form-control"></textarea><div class="admin-form-help">Her satıra bir süreç adımı yazın.</div></div>
        </div></fieldset>

        <fieldset class="admin-form-section"><legend>Başvuru Formu</legend><div class="admin-form-grid">
            <div class="admin-form-field admin-form-field--full"><label asp-for="Settings.SuccessMessage" class="form-label"></label><textarea asp-for="Settings.SuccessMessage" rows="3" class="form-control"></textarea></div>
            <div class="admin-form-field admin-form-field--full"><label asp-for="Settings.KvkkText" class="form-label"></label><textarea asp-for="Settings.KvkkText" rows="4" class="form-control"></textarea></div>
            <div class="admin-form-field admin-form-field--full"><label class="admin-form-switch"><input asp-for="Settings.FormEnabled" class="form-check-input" /><span><strong>Gönüllü başvuru formu açık</strong><small>Kapatıldığında bilgilendirme sayfası görünür kalır fakat yeni başvuru alınmaz.</small></span></label></div>
        </div></fieldset>

        @if (canEdit)
        {
            <div class="admin-form-actions"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Değişiklikleri Kaydet</button></div>
        }
    </form>

    <section class="admin-history-page mt-5"><div class="admin-module__header"><div><span class="admin-module__eyebrow">Sürüm Yönetimi</span><h2>Değişiklik Geçmişi</h2><p>Sayfa ayarlarının önceki sürümlerini geri yükleyebilirsiniz.</p></div></div>
        @if (Model.Revisions.Count == 0) { <div class="admin-empty-state"><i class="bi bi-clock-history"></i><p>Henüz eski sürüm bulunmuyor.</p></div> }
        else { <div class="admin-history-list">@foreach (var revision in Model.Revisions) { <article class="admin-history-card admin-history-card--compact"><div class="admin-history-card__content"><span class="admin-history-card__type">@revision.Summary</span><h3>@revision.ChangedAt.ToLocalTime().ToString("dd MMMM yyyy HH:mm", culture)</h3><p>@revision.ChangedBy</p></div><div class="admin-history-card__action">@if (canEdit) { <form asp-action="Restore" asp-route-id="@revision.Id" method="post" onsubmit="return confirm('Bu gönüllülük sayfası sürümüne geri dönülsün mü?');"><button class="btn" type="submit"><i class="bi bi-arrow-counterclockwise"></i> Bu Sürüme Dön</button></form> } @if (canDelete) { <form asp-action="DeleteRevision" asp-route-id="@revision.Id" method="post" onsubmit="return confirm('Bu geçmiş kaydı silinsin mi?');"><button class="admin-history-delete-button" type="submit" aria-label="Geçmiş kaydını sil"><i class="bi bi-trash3"></i></button></form> }</div></article> }</div> }
    </section>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
