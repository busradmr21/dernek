@model SigortaDernegi.Areas.Admin.ViewModels.MemberProfileFormViewModel

@{
    ViewData["Title"] = "Normal Üyeyi Düzenle";
}

<section class="admin-module">
    <div class="admin-module__header">
        <div>
            <span class="admin-module__eyebrow">Normal Üye Yönetimi</span>
            <h1>Üye Bilgilerini Düzenle</h1>
            <p>
                Üyelik bilgilerini, faal olma durumunu ve rehber
                görünürlüğünü güncelleyin.
            </p>
        </div>
    </div>

    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          class="admin-form-card">
        <partial name="_Form" model="Model" />

        <div class="admin-form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i>
                Değişiklikleri Kaydet
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                İptal
            </a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
