@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<main class="identity-forgot-page">
    <div class="identity-forgot-container">
        <section class="identity-forgot-card" aria-labelledby="forgot-title">

            <!-- Kurumsal Logo & Başlık Rozeti -->
            <div class="identity-brand-header">
                <div class="identity-brand-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div class="identity-brand-text">
                    <span class="identity-brand-kicker">ELSADER ŞİFRE YENİLEME</span>
                    <span class="identity-brand-subtitle">Elazığ Sigorta Acenteleri Derneği</span>
                </div>
            </div>

            <!-- Sayfa Başlığı ve Açıklama -->
            <h1 id="forgot-title">Şifrenizi mi unuttunuz?</h1>
            <p class="identity-forgot-intro">
                Kayıtlı e-posta adresinizi yazınız. Hesabınıza ait şifre sıfırlama adımlarını içeren bağlantıyı e-postanıza ileteceğiz.
            </p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger identity-validation" role="alert"></div>

                <!-- E-posta Kutusu (İkonlu) -->
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">E-posta Adresiniz</label>
                    <div class="identity-input-wrapper">
                        <i class="bi bi-envelope identity-input-icon"></i>
                        <input asp-for="Input.Email"
                               class="form-control identity-form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="ad.soyad@elsader.org.tr" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <!-- Gönder Butonu -->
                <button type="submit" class="btn identity-login-submit">
                    <span>Sıfırlama Bağlantısı Gönder</span>
                    <i class="bi bi-send-fill"></i>
                </button>

                <!-- Giriş Ekranına Dön Linki -->
                <div class="identity-forgot-back">
                    <a asp-page="./Login" class="identity-back-link">
                        <i class="bi bi-arrow-left"></i>
                        <span>Giriş ekranına geri dön</span>
                    </a>
                </div>

                <!-- Güvenlik İpucu Kutusu -->
                <div class="identity-security-tip">
                    <i class="bi bi-shield-check identity-security-tip-icon"></i>
                    <div class="identity-security-tip-text">
                        <strong>Güvenlik Notu:</strong> Şifre sıfırlama işlemi yalnızca sistemde kayıtlı ve aktif üyelerimiz için geçerlidir. Bağlantı 24 saat boyunca geçerliliğini korur.
                    </div>
                </div>
            </form>

        </section>
    </div>
</main>

@section Styles {
    <link rel="stylesheet" href="~/css/member-portal.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
